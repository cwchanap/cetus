---
import GamePage from '@/components/games/GamePage.astro'
import Card from '@/components/ui/Card.astro'
---

<GamePage
  gameId="ice-slide"
  title="Ice Slide"
  description="Slide across slippery ice until you hit a wall — reach the goal in the fewest moves!"
  icon="🧊"
  overlayTitle="MISSION COMPLETE!"
  overlayButtonText="Play Again"
  showPause={false}
  showReset={true}
>
  <div slot="game-board">
    <div class="relative w-full">
      <div
        id="game-canvas-container"
        class="bg-black/30 rounded-lg min-w-[240px] min-h-[240px] w-full flex items-center justify-center"
      >
      </div>

      <div
        id="game-status"
        class="absolute inset-0 flex items-center justify-center bg-black/70 rounded-lg"
      >
        <div class="text-center">
          <div class="text-6xl mb-4">🧊</div>
          <div
            class="text-xl font-mono font-bold mb-2 cetus-wordmark cetus-wordmark--glow"
            style="font-family: var(--cetus-display-font);"
          >
            ICE SLIDE
          </div>
          <div class="text-cetus-ink-muted">
            Press Start to begin the mission!
          </div>
        </div>
      </div>

      <div
        id="game-error"
        class="hidden text-sm text-amber-400 bg-amber-950/40 border border-amber-700/50 rounded-md px-3 py-2 text-center mt-2"
      >
      </div>
    </div>
  </div>

  <div slot="additional-stats" class="flex flex-wrap gap-4">
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Level: <span id="level">1</span>
    </div>
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Moves: <span id="moves">0</span>
    </div>
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Crystals: <span id="crystals">0</span>
    </div>
  </div>

  <div slot="game-info">
    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ HOW TO PLAY
      </h3>
      <ul class="space-y-2 text-sm text-cetus-ink-muted">
        <li>• Swipe or use arrow keys / WASD to slide</li>
        <li>• You keep sliding on ice until you hit a wall or rock</li>
        <li>• Stop on the green goal to clear the level</li>
        <li>• Avoid red holes — they reset the level</li>
        <li>• Collect cyan crystals for bonus points</li>
        <li>• Reset reloads the current level</li>
      </ul>
    </Card>

    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ SCORING
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Level clear:</span><span
            >200 × level</span
          >
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">At/under-par moves:</span><span
            >×25 each step</span
          >
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Crystal:</span><span>+50</span>
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Time bonus:</span><span
            >×5 / sec under 6:00</span
          >
        </div>
      </div>
      <p class="mt-3 text-xs text-cetus-ink-muted">
        Current sector: <span id="level-name">—</span>
      </p>
    </Card>
  </div>
</GamePage>

<script>
  import { initializeIceSlide } from '@/lib/games/ice-slide/init'

  let gameHandle: Awaited<ReturnType<typeof initializeIceSlide>> | null = null

  const init = async () => {
    const container = document.getElementById('game-canvas-container')
    const statusEl = document.getElementById('game-status')
    const errorEl = document.getElementById('game-error')
    const overlay = document.getElementById('game-over-overlay')
    const startBtn = document.getElementById('start-btn')
    const endBtn = document.getElementById('end-btn')
    const resetBtn = document.getElementById('reset-btn')
    const playAgainBtn = document.getElementById('play-again-btn')
    if (
      !container ||
      !statusEl ||
      !errorEl ||
      !overlay ||
      !startBtn ||
      !endBtn ||
      !playAgainBtn
    ) {
      return
    }

    const resetButtonState = () => {
      startBtn.style.display = 'inline-flex'
      endBtn.style.display = 'none'
    }

    try {
      gameHandle = await initializeIceSlide(container, {
        onGameStart: () => {
          statusEl.classList.add('hidden')
          errorEl.classList.add('hidden')
          overlay.classList.add('hidden')
          startBtn.style.display = 'none'
          endBtn.style.display = 'inline-flex'
        },
        onMove: () => {},
        onCrystal: () => {},
        onLevelClear: () => {},
        onHazard: () => {},
        onScoreUpdate: () => {},
        onTimeUpdate: () => {},
        onWin: () => {
          resetButtonState()
        },
        onError: (_title, message) => {
          errorEl.textContent = message
          errorEl.classList.remove('hidden')
        },
      })
    } catch (error) {
      errorEl.textContent =
        error instanceof Error ? error.message : 'Failed to load Ice Slide'
      errorEl.classList.remove('hidden')
      return
    }

    startBtn.addEventListener('click', async () => {
      try {
        await gameHandle?.start()
      } catch (error) {
        errorEl.textContent =
          error instanceof Error ? error.message : 'Failed to start'
        errorEl.classList.remove('hidden')
        resetButtonState()
      }
    })

    endBtn.addEventListener('click', () => {
      gameHandle?.stop()
      resetButtonState()
    })

    resetBtn?.addEventListener('click', () => {
      gameHandle?.resetLevel()
    })

    playAgainBtn.addEventListener('click', async () => {
      overlay.classList.add('hidden')
      try {
        await gameHandle?.start()
      } catch (error) {
        errorEl.textContent =
          error instanceof Error ? error.message : 'Failed to restart'
        errorEl.classList.remove('hidden')
        resetButtonState()
      }
    })
  }

  init()

  window.addEventListener('beforeunload', () => {
    gameHandle?.cleanup()
  })
</script>
