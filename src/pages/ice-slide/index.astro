---
import GamePage from '@/components/games/GamePage.astro'
import Card from '@/components/ui/Card.astro'
import Button from '@/components/ui/Button.astro'
---

<GamePage
  gameId="ice-slide"
  title="Ice Slide"
  description="Slide across slippery ice until you hit a wall — reach the goal in the fewest moves!"
  icon="🧊"
  overlayTitle="MISSION COMPLETE!"
  overlayButtonText="Play Again"
  showPause={false}
  showReset={true}
  initialTime={0}
>
  <div slot="game-board">
    <div class="w-full max-w-xl space-y-4">
      <fieldset
        id="ice-slide-mode-selector"
        class="rounded-lg border border-cetus-hairline bg-cetus-surface/70 px-4 py-3"
      >
        <legend class="px-1 font-mono text-xs tracking-wide text-cetus-accent">
          MODE
        </legend>
        <div
          class="flex flex-col gap-2 text-sm text-cetus-ink sm:flex-row sm:gap-5"
        >
          <label class="inline-flex items-center gap-2">
            <input
              type="radio"
              name="ice-slide-mode"
              value="campaign"
              checked
              class="accent-cetus-accent"
            />
            Campaign
          </label>
          <label class="inline-flex items-center gap-2">
            <input
              type="radio"
              name="ice-slide-mode"
              value="daily"
              class="accent-cetus-accent"
            />
            Daily
          </label>
        </div>
      </fieldset>

      <div class="relative w-full">
        <div
          id="game-canvas-container"
          class="bg-black/30 rounded-lg min-w-[240px] min-h-[240px] w-full flex items-center justify-center"
        >
        </div>

        <div
          id="game-status"
          class="absolute inset-0 flex items-center justify-center bg-black/70 rounded-lg"
        >
          <div class="text-center">
            <div class="text-6xl mb-4">🧊</div>
            <div
              class="text-xl font-mono font-bold mb-2 cetus-wordmark cetus-wordmark--glow"
              style="font-family: var(--cetus-display-font);"
            >
              ICE SLIDE
            </div>
            <div class="text-cetus-ink-muted">
              Choose a mode, then press Start to begin.
            </div>
          </div>
        </div>

        <div
          id="game-error"
          class="hidden text-sm text-amber-400 bg-amber-950/40 border border-amber-700/50 rounded-md px-3 py-2 text-center mt-2"
        >
        </div>

        <div
          id="stage-clear-overlay"
          class="absolute inset-0 z-40 hidden flex items-center justify-center bg-black/90 rounded-lg p-4"
        >
          <div
            class="w-full max-w-md rounded-2xl border border-cetus-accent/50 bg-cetus-surface p-6 text-center shadow-2xl"
          >
            <h2
              id="stage-clear-title"
              class="cetus-wordmark cetus-wordmark--glow text-2xl"
            >
              Stage clear
            </h2>
            <p id="stage-clear-score" class="mt-2 text-cetus-accent">+0</p>
            <div class="mt-5 space-y-2 text-left text-sm text-cetus-ink">
              <div id="stage-clear-clear">— Clear</div>
              <div id="stage-clear-efficient">— Efficient</div>
              <div id="stage-clear-bonus">— Bonus</div>
            </div>
            <Button
              id="stage-clear-continue-btn"
              type="button"
              class="mt-6 w-full"
              size="lg"
            >
              Continue
            </Button>
          </div>
        </div>
      </div>

      <Card id="daily-meta" variant="glass" class="hidden p-4">
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"
        >
          <div class="font-mono text-sm text-cetus-accent">
            Daily <span id="daily-date">—</span>
          </div>
          <div id="daily-reset" class="text-xs text-cetus-ink-muted">—</div>
          <div
            id="daily-stage-progress"
            class="w-full text-xs font-mono text-cetus-ink-muted"
          >
            Stage 1 / 5
          </div>
        </div>
        <div
          class="mt-3 grid gap-1 text-xs text-cetus-ink-muted sm:grid-cols-3"
        >
          <span id="daily-objective-clear">Clear the stage</span>
          <span id="daily-objective-efficient">Efficient: —</span>
          <span id="daily-objective-bonus">Bonus: —</span>
        </div>
      </Card>

      <Card id="daily-leaderboard" variant="glass" class="hidden p-4">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="font-mono text-sm tracking-wide text-cetus-accent">
            ▸ DAILY RANKING
          </h3>
          <span id="daily-leaderboard-date" class="text-xs text-cetus-ink-muted"
            >—</span
          >
        </div>
        <p
          id="daily-leaderboard-signed-out"
          class="hidden mt-2 text-xs text-cetus-ink-muted"
        >
          Sign in to submit a ranked result. You can still view today's ranking.
        </p>
        <p
          id="daily-leaderboard-loading"
          class="mt-3 text-sm text-cetus-ink-muted"
        >
          Loading ranking…
        </p>
        <p
          id="daily-leaderboard-empty"
          class="hidden mt-3 text-sm text-cetus-ink-muted"
        >
          No ranked finishes yet.
        </p>
        <p
          id="daily-leaderboard-unavailable"
          class="hidden mt-3 text-sm text-cetus-ink-muted"
        >
          Ranking is temporarily unavailable.
        </p>
        <div id="daily-leaderboard-rows" class="hidden mt-3 space-y-2"></div>
      </Card>
    </div>
  </div>

  <div slot="additional-stats" class="flex flex-wrap gap-4">
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Level: <span id="level">1</span>
    </div>
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Moves: <span id="moves">0</span>
    </div>
    <div
      class="font-mono text-cetus-accent border border-cetus-hairline rounded-lg px-4 py-2"
    >
      Crystals: <span id="crystals">0</span>
    </div>
  </div>

  <div slot="game-info">
    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ HOW TO PLAY
      </h3>
      <ul class="space-y-2 text-sm text-cetus-ink-muted">
        <li>• Swipe or use arrow keys / WASD to slide</li>
        <li>• You keep sliding on ice until you hit a wall or rock</li>
        <li>• Stop on the green goal to clear the level</li>
        <li>• Avoid red holes — they reset the level</li>
        <li>• Collect cyan crystals for bonus points</li>
        <li>• Reset reloads the current level</li>
      </ul>
    </Card>

    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ SCORING
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Level clear:</span><span
            >200 × level</span
          >
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">At/under-par moves:</span><span
            >×25 each step</span
          >
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Crystal:</span><span>+50</span>
        </div>
        <div class="flex justify-between">
          <span class="text-cetus-ink-muted">Time bonus:</span><span
            >×5 / sec under 6:00</span
          >
        </div>
      </div>
      <p class="mt-3 text-xs text-cetus-ink-muted">
        Current sector: <span id="level-name">—</span>
      </p>
    </Card>

    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ DAILY BRIEF
      </h3>
      <p class="text-sm text-cetus-ink-muted">
        Five seeded stages reset at 00:00 UTC each day.
      </p>
      <ul class="mt-3 space-y-2 text-xs text-cetus-ink-muted">
        <li>• Earn Clear, Efficient, and seeded Bonus stars.</li>
        <li>• Each optional star adds +100 points.</li>
        <li>• Finish the run within the 5:00 completion budget.</li>
        <li>• Play Again retries the same daily run and seed.</li>
      </ul>
    </Card>
  </div>

  <div slot="final-stats">
    <div
      id="daily-final-stage-result"
      class="hidden text-left text-sm text-cetus-ink"
    >
      <div class="mb-2 font-mono text-cetus-accent">Daily stars</div>
      <div id="daily-final-clear">— Clear</div>
      <div id="daily-final-efficient">— Efficient</div>
      <div id="daily-final-bonus">— Bonus</div>
    </div>
    <Button
      id="change-mode-btn"
      type="button"
      variant="outline"
      size="lg"
      class="w-full"
    >
      Change Mode
    </Button>
  </div>
</GamePage>

<script>
  import { initializeIceSlide } from '@/lib/games/ice-slide/init'
  import {
    createIceSlideDailyCompetitionKey,
    toIceSlideUtcDateKey,
  } from '@/lib/games/ice-slide/daily'
  import { createDailyLeaderboardController } from '@/lib/games/ice-slide/daily-leaderboard'
  import type { IceSlidePlayableMode } from '@/lib/games/ice-slide/types'

  const requestedMode = new URLSearchParams(window.location.search).get('mode')
  const selectedMode: IceSlidePlayableMode =
    requestedMode === 'daily' ? 'daily' : 'campaign'

  let gameHandle: Awaited<ReturnType<typeof initializeIceSlide>> | null = null

  const init = async () => {
    const container = document.getElementById('game-canvas-container')
    const statusEl = document.getElementById('game-status')
    const errorEl = document.getElementById('game-error')
    const overlay = document.getElementById('game-over-overlay')
    const startBtn = document.getElementById('start-btn')
    const endBtn = document.getElementById('end-btn')
    const resetBtn = document.getElementById('reset-btn')
    const playAgainBtn = document.getElementById('play-again-btn')
    const modeSelector = document.getElementById('ice-slide-mode-selector')
    const dailyMeta = document.getElementById('daily-meta')
    const modeRadios = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        '#ice-slide-mode-selector input[name="ice-slide-mode"]'
      )
    )
    const dailyFinalResult = document.getElementById('daily-final-stage-result')
    const changeModeBtn = document.getElementById('change-mode-btn')
    const leaderboardPanel = document.getElementById('daily-leaderboard')
    const leaderboardDate = document.getElementById('daily-leaderboard-date')
    const leaderboardSignedOut = document.getElementById(
      'daily-leaderboard-signed-out'
    )
    const leaderboardLoading = document.getElementById(
      'daily-leaderboard-loading'
    )
    const leaderboardEmpty = document.getElementById('daily-leaderboard-empty')
    const leaderboardUnavailable = document.getElementById(
      'daily-leaderboard-unavailable'
    )
    const leaderboardRows = document.getElementById('daily-leaderboard-rows')
    if (
      !container ||
      !statusEl ||
      !errorEl ||
      !overlay ||
      !startBtn ||
      !endBtn ||
      !playAgainBtn ||
      !modeSelector ||
      modeRadios.length === 0 ||
      !dailyMeta ||
      !dailyFinalResult ||
      !changeModeBtn ||
      !leaderboardPanel ||
      !leaderboardDate ||
      !leaderboardSignedOut ||
      !leaderboardLoading ||
      !leaderboardEmpty ||
      !leaderboardUnavailable ||
      !leaderboardRows
    ) {
      return
    }

    const leaderboardController = createDailyLeaderboardController({
      panel: leaderboardPanel,
      date: leaderboardDate,
      signedOut: leaderboardSignedOut,
      loading: leaderboardLoading,
      empty: leaderboardEmpty,
      unavailable: leaderboardUnavailable,
      rows: leaderboardRows,
    })

    const currentUtcDailyKey = () =>
      createIceSlideDailyCompetitionKey(toIceSlideUtcDateKey(new Date()))

    modeRadios.forEach(radio => {
      radio.checked = radio.value === selectedMode
    })

    const readSelectedMode = (): IceSlidePlayableMode =>
      modeRadios.find(radio => radio.checked)?.value === 'daily'
        ? 'daily'
        : 'campaign'

    const setModeControlsDisabled = (disabled: boolean) => {
      modeRadios.forEach(radio => {
        radio.disabled = disabled
      })
      modeSelector.toggleAttribute('aria-disabled', disabled)
    }

    const focusIdleControl = () => {
      const checkedModeRadio = modeRadios.find(
        radio =>
          radio.checked && !radio.disabled && radio.getClientRects().length > 0
      )
      ;(checkedModeRadio ?? startBtn).focus()
    }

    const restoreIdleModeControlsIfNoResult = () => {
      if (!overlay.classList.contains('hidden')) {
        return
      }
      setModeControlsDisabled(false)
      focusIdleControl()
    }

    const resetButtonState = () => {
      startBtn.style.display = 'inline-flex'
      endBtn.style.display = 'none'
    }

    try {
      gameHandle = await initializeIceSlide(container, {
        onGameStart: () => {
          statusEl.classList.add('hidden')
          errorEl.classList.add('hidden')
          overlay.classList.add('hidden')
          startBtn.style.display = 'none'
          endBtn.style.display = 'inline-flex'
          setModeControlsDisabled(true)
        },
        onMove: () => {},
        onCrystal: () => {},
        onLevelClear: () => {},
        onHazard: () => {},
        onScoreUpdate: () => {},
        onTimeUpdate: () => {},
        onWin: () => {
          resetButtonState()
        },
        onError: (_title, message) => {
          errorEl.textContent = message
          errorEl.classList.remove('hidden')
          restoreIdleModeControlsIfNoResult()
        },
        onScoreSaved: gameData => {
          if (gameData.mode === 'daily') {
            leaderboardController.load(gameData.runKey)
          }
        },
      })
    } catch (error) {
      errorEl.textContent =
        error instanceof Error ? error.message : 'Failed to load Ice Slide'
      errorEl.classList.remove('hidden')
      return
    }

    if (readSelectedMode() === 'daily') {
      leaderboardController.load(currentUtcDailyKey())
    } else {
      leaderboardController.hide()
    }

    startBtn.addEventListener('click', async () => {
      const mode = readSelectedMode()
      startBtn.style.display = 'none'
      setModeControlsDisabled(true)
      try {
        await gameHandle?.start(mode)
        if (mode === 'daily') {
          const runKey = gameHandle?.getGame()?.getState().runKey
          if (runKey) {
            leaderboardController.load(runKey)
          }
        } else {
          leaderboardController.hide()
        }
      } catch (error) {
        errorEl.textContent =
          error instanceof Error ? error.message : 'Failed to start'
        errorEl.classList.remove('hidden')
        resetButtonState()
        restoreIdleModeControlsIfNoResult()
      }
    })

    endBtn.addEventListener('click', () => {
      gameHandle?.stop()
      restoreIdleModeControlsIfNoResult()
    })

    resetBtn?.addEventListener('click', () => {
      gameHandle?.resetLevel()
    })

    playAgainBtn.addEventListener('click', async () => {
      overlay.classList.add('hidden')
      startBtn.style.display = 'none'
      endBtn.style.display = 'inline-flex'
      setModeControlsDisabled(true)
      try {
        await gameHandle?.playAgain()
        if (gameHandle?.getGame()?.getState().mode === 'daily') {
          const runKey = gameHandle.getGame()?.getState().runKey
          if (runKey) {
            leaderboardController.load(runKey)
          }
        } else {
          leaderboardController.hide()
        }
      } catch (error) {
        errorEl.textContent =
          error instanceof Error ? error.message : 'Failed to restart'
        errorEl.classList.remove('hidden')
        resetButtonState()
        restoreIdleModeControlsIfNoResult()
      }
    })

    changeModeBtn.addEventListener('click', () => {
      overlay.classList.add('hidden')
      dailyMeta.classList.add('hidden')
      dailyFinalResult.classList.add('hidden')
      statusEl.classList.remove('hidden')
      errorEl.classList.add('hidden')
      resetButtonState()
      setModeControlsDisabled(false)
      focusIdleControl()
      if (readSelectedMode() === 'daily') {
        leaderboardController.load(currentUtcDailyKey())
      } else {
        leaderboardController.hide()
      }
    })

    modeRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (readSelectedMode() === 'daily') {
          leaderboardController.load(currentUtcDailyKey())
        } else {
          leaderboardController.hide()
        }
      })
    })
  }

  init()

  window.addEventListener('beforeunload', () => {
    gameHandle?.cleanup()
  })
</script>
