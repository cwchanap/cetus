---
import GamePage from '@/components/games/GamePage.astro'
import Card from '@/components/ui/Card.astro'
import Badge from '@/components/ui/Badge.astro'
---

<GamePage
  gameId="pattern-pulse"
  title="Pattern Pulse"
  description="Watch the signal, then repeat the growing pattern before time runs out"
  icon="🔁"
  showPause={false}
  showEnd={false}
  initialTime={60}
>
  <div
    slot="game-board"
    id="pattern-pulse-container"
    class="w-[min(520px,calc(100vw-2rem))]"
  >
    <div
      id="pattern-pulse-board"
      class="grid grid-cols-2 gap-3 aspect-square"
      role="group"
      aria-label="Pattern Pulse signal pads"
    >
      <button
        type="button"
        class="pattern-pulse-pad"
        data-pattern-pad="0"
        aria-label="Pad 1, triangle"
        ><span aria-hidden="true">▲</span><span>1</span></button
      >
      <button
        type="button"
        class="pattern-pulse-pad"
        data-pattern-pad="1"
        aria-label="Pad 2, circle"
        ><span aria-hidden="true">●</span><span>2</span></button
      >
      <button
        type="button"
        class="pattern-pulse-pad"
        data-pattern-pad="2"
        aria-label="Pad 3, diamond"
        ><span aria-hidden="true">◆</span><span>3</span></button
      >
      <button
        type="button"
        class="pattern-pulse-pad"
        data-pattern-pad="3"
        aria-label="Pad 4, star"
        ><span aria-hidden="true">✦</span><span>4</span></button
      >
    </div>
    <p id="pattern-status" aria-live="polite">READY</p>
  </div>

  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Length: <span id="sequence-length">3</span></span>
  </Badge>
  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Rounds: <span id="completed-rounds">0</span></span>
  </Badge>
  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Streak: <span id="streak">0</span></span>
  </Badge>
  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Mistakes: <span id="mistakes">0</span></span>
  </Badge>

  <div slot="game-info" class="space-y-6">
    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ HOW TO PLAY
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <p>Watch the pads light up, then repeat the sequence.</p>
        <p>Click the pads or press keys 1–4 to answer.</p>
        <p>Each completed round adds one pad to the sequence.</p>
        <p>Three mistakes or running out of time ends the run.</p>
      </div>
    </Card>

    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ SCORING
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <p>Each completed pad is worth 100 points.</p>
        <p>Answer quickly for a speed bonus of up to 200 points.</p>
        <p>Consecutive rounds add a +50 streak bonus each.</p>
      </div>
    </Card>
  </div>

  <div slot="final-stats">
    <div class="text-lg text-cetus-ink">
      Outcome: <span id="final-outcome" class="text-cetus-accent">—</span>
    </div>
    <div class="text-lg text-cetus-ink">
      Rounds Cleared:
      <span id="final-rounds" class="text-cetus-accent-2">0</span>
    </div>
    <div class="text-lg text-cetus-ink">
      Longest Sequence:
      <span id="final-longest-sequence" class="text-cetus-accent-3">0</span>
    </div>
    <div class="text-lg text-cetus-ink">
      Max Streak: <span id="final-max-streak" class="text-cetus-accent">0</span>
    </div>
    <div class="text-lg text-cetus-ink">
      Mistakes: <span id="final-mistakes" class="text-cetus-accent-2">0</span>
    </div>
  </div>
</GamePage>

<script>
  import { initPatternPulseGameFramework } from '@/lib/games/pattern-pulse/initFramework'

  document.addEventListener('DOMContentLoaded', () => {
    initPatternPulseGameFramework()
      .then(handle => {
        if (handle) {
          ;(
            window as Window & { patternPulseGame?: typeof handle }
          ).patternPulseGame = handle
        }
      })
      .catch(error => {
        console.error('Pattern Pulse failed to initialize', error)
      })
  })
</script>

<style>
  /* Static pads live in the Astro template; the renderer only toggles
     data attributes, so all visual affordance lives here. Pads are never
     natively disabled — [aria-disabled='true'] keys the gated treatment. */
  .pattern-pulse-pad {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    color: var(--cetus-accent);
    background: color-mix(in srgb, var(--cetus-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cetus-accent) 25%, transparent);
    transition:
      transform 80ms ease,
      border-color 80ms ease,
      background-color 80ms ease,
      box-shadow 80ms ease;
  }
  .pattern-pulse-pad:hover {
    background: color-mix(in srgb, var(--cetus-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--cetus-accent) 50%, transparent);
  }
  .pattern-pulse-pad:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
  }
  .pattern-pulse-pad[data-active='true'] {
    transform: scale(1.04);
    background: color-mix(in srgb, var(--cetus-accent) 32%, transparent);
    border-color: var(--cetus-accent);
    box-shadow: 0 0 24px
      color-mix(in srgb, var(--cetus-accent) 45%, transparent);
  }
  .pattern-pulse-pad[data-feedback='wrong'] {
    color: var(--cetus-accent-3);
    background: color-mix(in srgb, var(--cetus-accent-3) 22%, transparent);
    border-color: var(--cetus-accent-3);
  }
  .pattern-pulse-pad[aria-disabled='true'] {
    cursor: default;
    opacity: 0.75;
  }
  #pattern-status {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.2em;
    color: var(--cetus-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .pattern-pulse-pad {
      transition: none;
    }
    .pattern-pulse-pad[data-active='true'] {
      transform: none;
    }
  }
</style>
