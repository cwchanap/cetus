---
import AppLayout from '@/layouts/AppLayout.astro'
import AchievementAward from '@/components/AchievementAward.astro'
import ChallengeComplete from '@/components/ChallengeComplete.astro'
const user = Astro.locals.user
const instructions = [
  {
    image: 'line',
    alt: 'A complete row of blocks clears',
    label: 'Fill a row · It clears',
  },
  {
    image: 'ghost',
    alt: 'The outline of a T shows where it will land',
    label: 'Outline shows the landing',
  },
  {
    image: 'four',
    alt: 'The long form clears four rows at once',
    label: 'Four at once · ×30 score',
  },
]
const neighbours = [
  {
    href: '/bubble-shooter',
    number: 'II',
    name: 'Bubble Shooter',
    color: '#6fe3ff',
  },
  { href: '/bejeweled', number: 'III', name: 'Bejeweled', color: '#ff3d8a' },
  { href: '/ice-slide', number: 'XV', name: 'Ice Slide', color: '#6fe3ff' },
]
---

<AppLayout
  title="Tetris Challenge — Cetus"
  description="Stack the seven forms. Clear the rows. Keep the well open."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>
  <div class="plate-width field-plate" data-signed-in={Boolean(user)}>
    <div class="title-row">
      <div>
        <p class="micro accent eyebrow">Pl. I — Mid-water · 200–1 000 m</p><h1>
          Tetris Challenge
        </h1>
      </div>
      <div class="tools">
        <button
          class="icon-button"
          data-sheet="commission"
          aria-label="Today's commission"
          title="Today's commission">🎮</button
        >
        <button
          class="icon-button"
          data-sheet="help"
          aria-label="How it plays"
          title="How it plays">?</button
        >
        <button
          class="icon-button"
          data-sheet="log"
          aria-label="Field log"
          title="Field log">▤</button
        >
        <button
          class="icon-button"
          id="pause-btn"
          aria-label="Pause"
          title="Pause (P)"
          disabled>Ⅱ</button
        >
      </div>
    </div>
    <div class="hud" aria-label="Dive statistics">
      <div class="score-stat">
        <div class="micro">Score</div><div id="score" class="large-stat">0</div>
      </div>
      <div class="small-stats">
        <div>
          <div class="micro">Lines</div><div class="stat-value" id="lines">
            0
          </div>
        </div>
        <div>
          <div class="micro">Best</div><div class="stat-value" data-best>—</div>
        </div>
        <div>
          <div class="micro">Streak</div><div
            class="stat-value amber"
            id="clear-streak"
          >
            ×0
          </div>
        </div>
      </div>
      <div class="descent">
        <div class="descent-label micro">
          <span>Descent rate · Level <span id="level">1</span></span><span
            id="drop-rate"
            class="accent">1.00 s</span
          >
        </div>
        <progress id="rate-fill" max="100" value="4" aria-label="Descent rate"
        ></progress>
        <div id="next-level" class="micro chain-note">10 lines to level 2</div>
      </div>
    </div>
    <div class="play-area">
      <div class="plate-frame">
        {
          ['top-left', 'top-right', 'bottom-left', 'bottom-right'].map(c => (
            <span class={`corner ${c}`} aria-hidden="true" />
          ))
        }
        <div id="tetris-container" aria-label="Tetris playfield"></div>
        <div id="clear-flash" aria-hidden="true">
          {Array.from({ length: 20 }, () => <span />)}
        </div>
        <div id="line-feedback" class="mono" role="status"></div>
      </div>
      <aside class="piece-trays" aria-label="Upcoming and held forms">
        <div class="piece-tray">
          <p class="micro">Next</p><canvas
            id="next-canvas"
            width="240"
            height="300"
            aria-label="Next three forms"></canvas>
        </div>
        <button
          id="hold-btn"
          class="piece-tray"
          title="Tap to hold (C)"
          aria-label="Hold piece"
          disabled
        >
          <span class="descent-label micro"
            ><span>Hold</span><span id="hold-state" class="accent">Ready</span
            ></span
          >
          <canvas
            id="hold-canvas"
            width="240"
            height="140"
            aria-label="Held form"></canvas>
        </button>
      </aside>
    </div>
    <p class="micro controls-hint">
      Swipe the plate · ← → move · ↑ rotate · ↓ soft · Space drop · C hold
    </p>
  </div>
  <Fragment slot="notifications">
    <dialog id="field-sheet" aria-labelledby="intro-title">
      <section id="intro-panel" data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. I · Specimen notes</span><span
            class="micro">Lattice · Seven forms</span
          >
        </div>
        <h2 id="intro-title">Tetris Challenge</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { amber: i === 2 }]}>
                    <span class:list={['accent', { amber: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="record-line">
          <span class="micro">{user ? 'Your best' : 'Best this visit'}</span
          ><span class="mono" data-best>—</span>
        </div>
        <p id="game-error" class="error-message hidden" role="alert">
          The plate could not be loaded. Refresh to try again.
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Loading the plate…</button
        >
        <div class="action-pair">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section id="pause-panel" data-panel="pause" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Starting level</p>
        <div class="action-pair" role="group" aria-label="Starting level">
          {
            [1, 5, 10].map(level => (
              <button
                class="secondary-action"
                data-level={level}
                aria-pressed={level === 1}
              >
                {level}
              </button>
            ))
          }
        </div>
        <p class="setting-note">
          Applies on the next dive. Higher levels drop faster and score more per
          line.
        </p>
        <div class="settings">
          <button id="ghost-btn" aria-pressed="true"
            ><span>Landing outline</span><span class="micro" data-state>On</span
            ></button
          >
          <button id="glyphs-btn" aria-pressed="false"
            ><span>Form letters</span><span class="micro" data-state>Off</span
            ></button
          >
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span class="micro" data-state>On</span></button
          >
          <button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span class="micro" data-state>Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button>
        <button id="reset-btn" class="secondary-action"
          >Abandon &amp; restart</button
        >
        <button id="end-btn" class="exit-action micro" style="display:none"
          >End dive</button
        >
        <p class="micro controls-hint">
          P resume · Arrows move · Space drop · C hold
        </p>
      </section>
      <section id="game-over-overlay" data-panel="results" class="hidden">
        <div class="sheet-kicker">
          <span class="micro">Dive record · Pl. I</span><span
            id="personal-best"
            class="micro new-best hidden">Personal best</span
          >
        </div>
        <h2 id="results-title">The stack won</h2>
        <div class="result-score">
          <div>
            <span class="micro">Score</span><div
              id="final-score"
              class="large-stat"
            >
              0
            </div>
          </div><div>
            <span class="micro">Reached</span><div class="stat-value ice">
              Level <span id="final-level">1</span>
            </div>
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Lines cleared</dt><dd id="final-lines">0</dd></div>
          <div><dt>Forms placed</dt><dd id="final-pieces">0</dd></div>
          <div>
            <dt>Longest clear streak</dt><dd id="final-streak" class="amber">
              ×0
            </dd>
          </div>
          <div>
            <dt>Points per form</dt><dd id="per-form" class="ice">—</dd>
          </div>
          <div><dt>Previous best</dt><dd id="previous-best">—</dd></div>
        </dl>
        <p class="micro settings-label">Clear breakdown</p>
        <div class="clear-breakdown">
          {
            ['Single', 'Double', 'Triple', 'Tetris'].map((label, i) => (
              <div
                class:list={[{ amber: i === 3, ice: i === 2, accent: i < 2 }]}
              >
                <>
                  <div class="clear-bar">
                    <span data-clear-bar={i} />
                  </div>
                  <p class="micro">{label}</p>
                  <span class="mono" data-clear-count={i}>
                    0
                  </span>
                </>
              </div>
            ))
          }
        </div>
        <div class="field-note">
          <span class="micro">Field note</span><p id="result-advice">
            Keep a well open on one side and feed it the long form.
          </p>
        </div>
        <p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={{ background: item.color }} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="play-again-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div>
        <h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { amber: i === 2 }]}>
                    <span class:list={['accent', { amber: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>One line</dt><dd>40 × level</dd></div>
          <div><dt>Four lines</dt><dd class="amber">1 200 × level</dd></div>
          <div><dt>Every 10 lines</dt><dd>Level up · Faster</dd></div>
          <div><dt>Hold</dt><dd>Once per form</dd></div>
        </dl>
        <p class="micro settings-label">Controls · Touch / Keys</p>
        <dl class="result-rows method-rows">
          <div><dt>Swipe sideways to move</dt><dd>← →</dd></div>
          <div><dt>Tap the plate to rotate</dt><dd>↑</dd></div>
          <div><dt>Soft drop</dt><dd>↓</dd></div>
          <div><dt>Swipe down to hard drop</dt><dd>Space</dd></div>
          <div><dt>Hold a form</dt><dd>C</dd></div>
          <div><dt>Pause the dive</dt><dd>P</dd></div>
        </dl>
        <button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Tetrises this visit</span><strong
              class="amber"
              id="visit-tetrises">0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user
              ? 'Saved scores & achievements ↗'
              : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In mid-water</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AchievementAward /><ChallengeComplete />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>
<script>
  import {
    initTetrisGameFramework,
    type TetrisInitResult,
  } from '@/lib/games/tetris/initFramework'
  import type { TetrisState, TetrisStats } from '@/lib/games/tetris/types'
  import { LINE_CLEAR_BASE_SCORE } from '@/lib/games/tetris/TetrisGame'
  import { getUserBestScore } from '@/lib/services/scoreService'
  import { GameID } from '@/lib/games'
  import type { UserChallengeProgress } from '@/lib/challenges'

  const sheet = document.querySelector<HTMLDialogElement>('#field-sheet')!
  const panels = [...sheet.querySelectorAll<HTMLElement>('[data-panel]')]
  const startButton = document.querySelector<HTMLButtonElement>('#start-btn')!
  const pauseButton = document.querySelector<HTMLButtonElement>('#pause-btn')!
  const holdButton = document.querySelector<HTMLButtonElement>('#hold-btn')!
  const signedIn =
    document.querySelector<HTMLElement>('.field-plate')!.dataset.signedIn ===
    'true'
  const setText = (id: string, value: string | number) => {
    document.getElementById(id)!.textContent = String(value)
  }
  let handle: TetrisInitResult | undefined
  let currentPanel = 'intro'
  let returnPanel = 'intro'
  let resumeAfterSheet = false
  let savedBest: number | null = signedIn ? null : 0
  let visitBest = 0
  let lastResult: { score: number; previousBest: number } | null = null
  let visits = 0
  let visitTetrises = 0
  let lastLines = 0
  let startingLevel = 1
  let ghost = true
  let glyphs = false
  let sound = true
  let reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
  let audio: AudioContext | undefined
  const controller = new AbortController()
  const { signal } = controller

  const syncBest = () => {
    const best = savedBest === null ? null : Math.max(savedBest, visitBest)
    document.querySelectorAll('[data-best]').forEach(el => {
      el.textContent = best === null ? '—' : best.toLocaleString()
    })
    setText(
      'previous-best',
      savedBest === null
        ? '—'
        : Math.max(savedBest, lastResult?.previousBest ?? 0).toLocaleString()
    )
    document
      .getElementById('personal-best')!
      .classList.toggle(
        'hidden',
        savedBest === null ||
          lastResult === null ||
          lastResult.score <= Math.max(savedBest, lastResult.previousBest)
      )
  }
  const showSheet = (panel: string) => {
    currentPanel = panel
    panels.forEach(el =>
      el.classList.toggle('hidden', el.dataset.panel !== panel)
    )
    sheet.dataset.panel = panel
    sheet.setAttribute(
      'aria-labelledby',
      `${panel === 'intro' ? 'intro' : panel}-title`
    )
    if (!sheet.open) {
      sheet.showModal()
    }
    const heading = sheet.querySelector<HTMLElement>(
      `:scope > [data-panel="${panel}"] h2`
    )!
    heading.tabIndex = -1
    heading.focus({ preventScroll: true })
    sheet.scrollTop = 0
  }
  const closeSheet = () => {
    currentPanel = ''
    sheet.close()
    handle?.renderer.getApp()?.canvas.focus()
  }
  const closeInfo = () => {
    if (resumeAfterSheet) {
      resumeAfterSheet = false
      handle?.game.resume()
    } else if (returnPanel) {
      showSheet(returnPanel)
    } else {
      closeSheet()
    }
  }
  const refreshAccount = async () => {
    if (!signedIn) {
      return
    }
    try {
      const response = await fetch('/api/challenges', { signal })
      if (!response.ok) {
        throw new Error('Challenges unavailable')
      }
      const data: {
        challenges: UserChallengeProgress[]
        xp: number
        level: number
        xpProgress: number
        xpToNextLevel: number
        streak: number
      } = await response.json()
      setText('account-label', `LV ${data.level}`)
      setText('xp-label', `Level ${data.level} · ${data.xp} XP`)
      setText('xp-next', `${data.xpToNextLevel} to next level`)
      setText('streak', `${data.streak} days`)
      document.getElementById('xp-panel')!.classList.remove('hidden')
      document.querySelector<HTMLProgressElement>('#xp-fill')!.value =
        data.xpProgress
      const available = data.challenges.filter(
        c => !c.gameId || c.gameId === GameID.TETRIS
      )
      setText(
        'commission-status',
        available.length
          ? 'Complete a dive to record your progress.'
          : 'No Tetris Challenge commissions today. Explore the catalogue for today’s challenges.'
      )
      const container = document.getElementById('commissions')!
      container.replaceChildren()
      available.forEach(challenge => {
        const fragment = document
          .querySelector<HTMLTemplateElement>('#commission-template')!
          .content.cloneNode(true) as DocumentFragment
        fragment.querySelector('[data-icon]')!.textContent = challenge.icon
        fragment.querySelector('[data-name]')!.textContent = challenge.name
        fragment.querySelector('[data-xp]')!.textContent =
          `+${challenge.xpReward} XP`
        fragment.querySelector('[data-description]')!.textContent =
          challenge.description
        fragment.querySelector('progress')!.value = Math.min(
          100,
          (challenge.currentValue / challenge.targetValue) * 100
        )
        fragment.querySelector('[data-progress]')!.textContent =
          challenge.completed
            ? 'Completed'
            : `${challenge.currentValue} / ${challenge.targetValue}`
        container.append(fragment)
      })
    } catch {
      if (!signal.aborted) {
        setText(
          'commission-status',
          'Commissions are unavailable. Open this panel again to retry.'
        )
      }
    }
  }
  const refreshLeaderboard = async () => {
    try {
      const response = await fetch('/api/leaderboard?gameId=tetris&limit=5', {
        signal,
      })
      if (!response.ok) {
        throw new Error('Leaderboard unavailable')
      }
      const data: {
        leaderboard: Array<{ rank: number; name: string; score: number }>
      } = await response.json()
      const list = document.getElementById('leaderboard')!
      list.replaceChildren()
      data.leaderboard.forEach(entry => {
        const row = document.createElement('li')
        const name = document.createElement('span')
        name.textContent = `${entry.rank}. ${entry.name}`
        const score = document.createElement('span')
        score.className = 'mono'
        score.textContent = entry.score.toLocaleString()
        row.append(name, score)
        list.append(row)
      })
      setText(
        'leaderboard-status',
        data.leaderboard.length ? '' : 'No recorded dives yet.'
      )
    } catch {
      if (!signal.aborted) {
        setText(
          'leaderboard-status',
          'The leaderboard is unavailable. Open the field log again to retry.'
        )
      }
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-sheet]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        returnPanel = currentPanel
        const state = handle?.game.getState()
        resumeAfterSheet = Boolean(state?.isActive && !state.isPaused)
        if (resumeAfterSheet) {
          handle?.game.pause()
        }
        showSheet(button.dataset.sheet!)
        if (currentPanel === 'log') {
          void refreshLeaderboard()
          void refreshAccount()
        }
        if (currentPanel === 'commission') {
          void refreshAccount()
        }
      },
      { signal }
    )
  )
  sheet
    .querySelectorAll('[data-close]')
    .forEach(button => button.addEventListener('click', closeInfo, { signal }))
  sheet.addEventListener(
    'cancel',
    event => {
      event.preventDefault()
      if (panels.some(panel => panel.inert)) {
        return
      }
      if (['help', 'log', 'commission'].includes(currentPanel)) {
        closeInfo()
      } else if (currentPanel === 'pause') {
        handle?.game.resume()
      }
    },
    { signal }
  )
  // A second Escape makes the browser's close watcher force-close the dialog
  // (non-cancelable), bypassing closeSheet — reopen the panel it stranded.
  sheet.addEventListener(
    'close',
    () => {
      if (currentPanel) {
        showSheet(currentPanel)
      }
    },
    { signal }
  )
  const awards = document.getElementById('achievement-award-overlay')!
  const challenges = document.getElementById('challenge-complete-overlay')!
  const rewardObserver = new MutationObserver(() => {
    const active = !challenges.classList.contains('hidden')
      ? challenges
      : awards.style.display === 'flex'
        ? awards
        : null
    const wasBlocked = panels[0].inert
    if (active && !sheet.open) {
      handle?.game.pause()
    }
    panels.forEach(panel => {
      panel.inert = Boolean(active)
    })
    if (active) {
      active.querySelector<HTMLElement>('[data-card], button')?.focus()
    } else if (wasBlocked && sheet.open) {
      showSheet(currentPanel)
    }
  })
  rewardObserver.observe(awards, {
    attributes: true,
    attributeFilter: ['style'],
  })
  rewardObserver.observe(challenges, {
    attributes: true,
    attributeFilter: ['class'],
  })

  const preferences = () => {
    handle?.setPreferences(ghost, glyphs)
    document
      .querySelector('.field-plate')
      ?.classList.toggle('reduced-motion', reducedMotion)
    document
      .querySelectorAll<HTMLButtonElement>('[data-level]')
      .forEach(button =>
        button.setAttribute(
          'aria-pressed',
          String(Number(button.dataset.level) === startingLevel)
        )
      )
    for (const [id, value] of [
      ['ghost-btn', ghost],
      ['glyphs-btn', glyphs],
      ['sound-btn', sound],
      ['motion-btn', reducedMotion],
    ] as const) {
      const button = document.getElementById(id)!
      button.setAttribute('aria-pressed', String(value))
      button.querySelector('[data-state]')!.textContent = value ? 'On' : 'Off'
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-level]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        startingLevel = Number(button.dataset.level)
        handle?.game.setStartingLevel(startingLevel)
        preferences()
      },
      { signal }
    )
  )
  document.getElementById('ghost-btn')!.addEventListener(
    'click',
    () => {
      ghost = !ghost
      preferences()
    },
    { signal }
  )
  document.getElementById('glyphs-btn')!.addEventListener(
    'click',
    () => {
      glyphs = !glyphs
      preferences()
    },
    { signal }
  )
  document.getElementById('sound-btn')!.addEventListener(
    'click',
    () => {
      sound = !sound
      preferences()
    },
    { signal }
  )
  document.getElementById('motion-btn')!.addEventListener(
    'click',
    () => {
      reducedMotion = !reducedMotion
      preferences()
    },
    { signal }
  )
  document
    .getElementById('resume-btn')!
    .addEventListener('click', () => handle?.game.resume(), { signal })
  holdButton.addEventListener(
    'click',
    () => {
      handle?.game.holdPiece()
      handle?.renderer.getApp()?.canvas.focus()
    },
    { signal }
  )
  document.addEventListener(
    'keydown',
    event => {
      if (
        event.key.toLowerCase() === 'p' &&
        currentPanel === 'pause' &&
        !panels.some(panel => panel.inert)
      ) {
        event.preventDefault()
        handle?.game.resume()
      }
    },
    { signal }
  )
  document.addEventListener(
    'visibilitychange',
    () => {
      if (document.hidden) {
        handle?.game.pause()
      }
    },
    { signal }
  )
  const blip = () => {
    if (!sound) {
      return
    }
    try {
      audio ??= new AudioContext()
      void audio.resume().catch(() => {})
      const oscillator = audio.createOscillator(),
        gain = audio.createGain()
      oscillator.type = 'triangle'
      oscillator.frequency.value = 540
      gain.gain.setValueAtTime(0.035, audio.currentTime)
      gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.14)
      oscillator.connect(gain)
      gain.connect(audio.destination)
      oscillator.start()
      oscillator.stop(audio.currentTime + 0.14)
    } catch {
      /* Audio may be unavailable in the browser. */
    }
  }
  document
    .querySelectorAll<HTMLCanvasElement>('canvas.rule-figure')
    .forEach(cv => {
      const c = cv.getContext('2d')
      if (!c) {
        return
      }
      const W = cv.width
      const H = cv.height
      c.clearRect(0, 0, W, H)
      const cell = 20
      const cols = 10
      const originX = (W - cols * cell) / 2
      const cellRect = (
        col: number,
        row: number,
        fill: string | null,
        stroke?: string
      ) => {
        const x = originX + col * cell
        const y = H - (row + 1) * cell - 20
        if (fill) {
          c.fillStyle = fill
          c.fillRect(x + 1, y + 1, cell - 2, cell - 2)
        }
        if (stroke) {
          c.strokeStyle = stroke
          c.lineWidth = 1.5
          c.strokeRect(x + 1.5, y + 1.5, cell - 3, cell - 3)
        }
      }
      c.strokeStyle = 'rgba(234,246,255,0.07)'
      c.lineWidth = 1
      for (let col = 0; col <= cols; col++) {
        const x = originX + col * cell
        c.beginPath()
        c.moveTo(x, 20)
        c.lineTo(x, H - 20)
        c.stroke()
      }
      const fig = cv.dataset.fig
      if (fig === 'line') {
        // a full row, about to clear, with the piece that completed it
        for (let col = 0; col < cols; col++) {
          cellRect(
            col,
            0,
            col === 4 || col === 5 ? '#ffff00' : 'rgba(111,227,255,0.5)'
          )
        }
        cellRect(4, 1, '#ffff00')
        cellRect(5, 1, '#ffff00')
        c.strokeStyle = '#22F5D0'
        c.lineWidth = 2.5
        c.beginPath()
        c.moveTo(originX - 6, H - cell - 20 + cell / 2)
        c.lineTo(originX + cols * cell + 6, H - cell - 20 + cell / 2)
        c.stroke()
      } else if (fig === 'ghost') {
        // the T piece up top, its landing outlined below
        cellRect(4, 7, '#800080')
        cellRect(3, 6, '#800080')
        cellRect(4, 6, '#800080')
        cellRect(5, 6, '#800080')
        cellRect(4, 1, null, 'rgba(234,246,255,0.55)')
        cellRect(3, 0, null, 'rgba(234,246,255,0.55)')
        cellRect(4, 0, null, 'rgba(234,246,255,0.55)')
        cellRect(5, 0, null, 'rgba(234,246,255,0.55)')
        c.strokeStyle = 'rgba(234,246,255,0.3)'
        c.setLineDash([3, 5])
        c.lineWidth = 1.5
        c.beginPath()
        c.moveTo(originX + 4.5 * cell, H - 7 * cell - 20)
        c.lineTo(originX + 4.5 * cell, H - 2 * cell - 20)
        c.stroke()
        c.setLineDash([])
      } else {
        // four rows going at once with the I piece standing in the well
        for (let row = 0; row < 4; row++) {
          for (let col = 0; col < cols; col++) {
            cellRect(col, row, col === 9 ? '#00ffff' : 'rgba(111,227,255,0.38)')
          }
        }
        c.strokeStyle = '#FFC24A'
        c.lineWidth = 2.5
        c.strokeRect(
          originX + 1,
          H - 4 * cell - 20 + 1,
          cols * cell - 2,
          4 * cell - 2
        )
      }
    })
  showSheet('intro')
  const initialize = async () => {
    try {
      handle = await initTetrisGameFramework(
        {
          blockSize: 32,
          gameWidth: 320,
          gameHeight: 640,
          backgroundColor: 0x070b16,
          gridColor: 0xeaf6ff,
        },
        {
          onStart: () => {
            closeSheet()
            lastLines = 0
            pauseButton.disabled = false
            document.getElementById('line-feedback')!.textContent = ''
            document
              .querySelectorAll('#clear-flash span')
              .forEach(el => el.classList.remove('flash'))
          },
          onPause: () => showSheet('pause'),
          onResume: closeSheet,
          onScoreUpdate: score => {
            if (score > 0) {
              blip()
            }
          },
          onStateChange: state => {
            const s = state as TetrisState
            setText('clear-streak', `×${s.stats.consecutiveLineClears}`)
            setText('drop-rate', `${(s.dropInterval / 1000).toFixed(2)} s`)
            setText(
              'next-level',
              `${10 - (s.lines % 10)} lines to level ${s.level + 1}`
            )
            const bar =
              document.querySelector<HTMLProgressElement>('#rate-fill')!
            bar.value = Math.max(4, ((1000 - s.dropInterval) / 950) * 100)
            for (const el of [bar, document.getElementById('drop-rate')!]) {
              el.classList.toggle(
                'amber',
                s.dropInterval <= 550 && s.dropInterval > 250
              )
              el.classList.toggle('urgent', s.dropInterval <= 250)
            }
            holdButton.disabled = !s.isActive || s.isPaused || s.holdUsed
            setText('hold-state', s.holdUsed ? 'Used' : 'Ready')
            document
              .getElementById('hold-state')!
              .classList.toggle('accent', !s.holdUsed)
            const count = s.lines - lastLines
            if (count > 0) {
              const feedback = document.getElementById('line-feedback')!
              feedback.textContent = `${['', 'Single', 'Double', 'Triple', 'Tetris'][count]} +${(LINE_CLEAR_BASE_SCORE[count] ?? 0) * s.level}`
              feedback.classList.toggle('amber', count === 4)
              feedback.getAnimations().forEach(a => a.cancel())
              feedback.animate(
                reducedMotion
                  ? [{ opacity: 1 }, { opacity: 1 }]
                  : [
                      { opacity: 1, transform: 'translate(-50%, 0)' },
                      { opacity: 0, transform: 'translate(-50%, -60px)' },
                    ],
                { duration: 900 }
              )
              document
                .querySelectorAll<HTMLElement>('#clear-flash span')
                .forEach((el, row) => {
                  el.classList.remove('flash')
                  void el.offsetWidth
                  if (!reducedMotion && s.clearedRows.includes(row)) {
                    el.classList.add('flash')
                  }
                })
            }
            lastLines = s.lines
          },
          onEnd: (score, stats) => {
            const s = stats as TetrisStats
            pauseButton.disabled = true
            holdButton.disabled = true
            lastResult = { score, previousBest: visitBest }
            visitBest = Math.max(visitBest, score)
            syncBest()
            setText('final-streak', `×${s.maxConsecutiveLineClears}`)
            setText('per-form', s.pieces ? Math.round(score / s.pieces) : '—')
            setText(
              'results-title',
              s.tetrises
                ? 'A clean four'
                : s.lines >= 10
                  ? 'Steady quarrying'
                  : 'The stack won'
            )
            setText(
              'result-advice',
              s.tetrises
                ? 'Four at once is where the score lives — that single clear paid as much as thirty singles. Keep a well open on one side and feed it the long form.'
                : s.lines >= 10
                  ? 'Good volume, thin value. Singles pay 40; four together pay 1,200. Stack flat and hold one column open.'
                  : 'The stack outran you. Use the landing outline and drop early — a clean floor is worth more than a fast one.'
            )
            const clears = [s.singles, s.doubles, s.triples, s.tetrises],
              max = Math.max(1, ...clears)
            document
              .querySelectorAll<HTMLElement>('[data-clear-bar]')
              .forEach((el, i) => {
                el.style.height = `${(clears[i] / max) * 100}%`
              })
            document.querySelectorAll('[data-clear-count]').forEach((el, i) => {
              el.textContent = String(clears[i])
            })
            visits++
            visitTetrises += s.tetrises
            setText('visit-count', visits)
            setText('visit-tetrises', visitTetrises)
            document.getElementById('empty-log')!.classList.add('hidden')
            const row = document.createElement('li'),
              label = document.createElement('span'),
              value = document.createElement('span')
            label.textContent = `Dive ${visits} · ${s.lines} lines · lv ${s.level}`
            value.className = 'mono'
            value.textContent = score.toLocaleString()
            row.append(label, value)
            document.getElementById('recent-dives')!.prepend(row)
            showSheet('results')
          },
        }
      )
      if (!handle) {
        throw new Error('Tetris renderer unavailable')
      }
      // onEnd fires before the score save resolves, so account state (XP,
      // challenge labels) refreshes off the post-save structured end event.
      // The event.data guard skips bare end events forwarded from the timer.
      handle.game.on('end', event => {
        if (event.data) {
          void refreshAccount()
        }
      })
      ;(window as Window & { tetrisGame?: TetrisInitResult }).tetrisGame =
        handle
      const canvas = handle.renderer.getApp()!.canvas
      let touch:
        | { x: number; y: number; id: number; moved: boolean; columns: number }
        | undefined
      canvas.addEventListener(
        'pointerdown',
        event => {
          if (
            !handle?.game.getState().isActive ||
            handle.game.getState().isPaused
          ) {
            return
          }
          canvas.focus()
          canvas.setPointerCapture(event.pointerId)
          touch = {
            x: event.clientX,
            y: event.clientY,
            id: event.pointerId,
            moved: false,
            columns: 0,
          }
        },
        { signal }
      )
      canvas.addEventListener(
        'pointermove',
        event => {
          if (!touch || event.pointerId !== touch.id) {
            return
          }
          const size = canvas.getBoundingClientRect().width / 10
          const dx = event.clientX - touch.x
          const dy = event.clientY - touch.y
          touch.moved ||= Math.abs(dx) > 8 || Math.abs(dy) > 8
          if (Math.abs(dx) >= Math.abs(dy)) {
            const columns = Math.round(dx / size)
            const steps = columns - touch.columns
            for (let i = 0; i < Math.abs(steps); i++) {
              if (steps > 0) {
                handle?.game.moveRight()
              } else {
                handle?.game.moveLeft()
              }
            }
            touch.columns = columns
          }
        },
        { signal }
      )
      canvas.addEventListener(
        'pointerup',
        event => {
          if (!touch || event.pointerId !== touch.id) {
            return
          }
          const dx = event.clientX - touch.x
          const dy = event.clientY - touch.y
          if (dy > 36 && dy > Math.abs(dx)) {
            handle?.game.hardDrop()
          } else if (!touch.moved && Math.abs(dx) <= 8 && Math.abs(dy) <= 8) {
            handle?.game.rotate()
          }
          touch = undefined
        },
        { signal }
      )
      canvas.addEventListener(
        'pointercancel',
        () => {
          touch = undefined
        },
        { signal }
      )
      preferences()
      startButton.disabled = false
      startButton.textContent = 'Begin the dive'
      if (signedIn) {
        savedBest = await getUserBestScore(GameID.TETRIS)
      }
      syncBest()
      void refreshAccount()
    } catch (error) {
      console.error('Failed to initialize Tetris Challenge:', error)
      document.getElementById('game-error')!.classList.remove('hidden')
      startButton.textContent = 'Plate unavailable'
    }
  }
  void initialize()
  window.addEventListener(
    'pagehide',
    event => {
      if (event.persisted) {
        handle?.game.pause()
        return
      }
      controller.abort()
      rewardObserver.disconnect()
      handle?.cleanup()
      void audio?.close()
    },
    { signal }
  )
</script>
