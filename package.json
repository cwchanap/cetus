{
  "name": "cetus",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "turbo run db:dev web:dev --parallel --ui tui",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:dev": "mkdir -p ./db && touch ./db/db.sqlite && turso dev --db-file ./db/db.sqlite",
    "web:dev": "astro dev --port 4325",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "validate:ice-slide-expedition": "bun scripts/validate-ice-slide-expedition.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "turbo": "turbo",
    "build:turbo": "turbo run build",
    "dev:turbo": "turbo run dev --parallel",
    "lint:turbo": "turbo run lint",
    "test:turbo": "turbo run test",
    "test:e2e:turbo": "turbo run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/vercel": "^8.2.0",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "astro": "^5.10.1",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "kysely": "^0.29.6",
    "lucide-react": "^0.525.0",
    "pixi.js": "^8.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/eslint__js": "^8.42.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^18.0.8",
    "eslint": "^9.30.1",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.11.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}