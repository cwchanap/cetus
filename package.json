{
  "name": "cetus",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run db:dev web:dev --parallel --ui tui",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "astro": "bun run --cwd apps/web astro",
    "db:dev": "bun run --cwd apps/web db:dev",
    "web:dev": "bun run --cwd apps/web web:dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "validate:ice-slide-expedition": "bun run --cwd apps/web validate:ice-slide-expedition",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "e2e:db:init": "bun run --cwd apps/web e2e:db:init",
    "test:e2e:ui": "bun run --cwd apps/web test:e2e:ui",
    "test:e2e:headed": "bun run --cwd apps/web test:e2e:headed",
    "test:e2e:debug": "bun run --cwd apps/web test:e2e:debug",
    "test:e2e:report": "bun run --cwd apps/web test:e2e:report",
    "typecheck": "bun run --cwd apps/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "turbo": "turbo",
    "build:turbo": "turbo run build",
    "test:turbo": "turbo run test",
    "test:e2e:turbo": "turbo run test:e2e"
  },
  "devDependencies": {
    "@cetus/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "turbo": "^2.11.8",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4"
  },
  "overrides": {
    "debug": "^4.4.3",
    "jiti": "^2.7.0",
    "lightningcss": "1.32.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
