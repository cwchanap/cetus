{
    "extends": "@cetus/config/tsconfig.base.json",
    "include": ["src/**/*.ts"],
    "compilerOptions": {
        "noEmit": true,
        // ES standard library only — no DOM. Game simulation must not
        // reference browser globals; renderers and web initializers stay
        // in apps/web.
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        // setInterval/setTimeout typings come from Node's typings; DOM is
        // intentionally absent so browser globals are a compile error
        // inside the package.
        "types": ["node"]
    }
}
