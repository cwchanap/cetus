{
  "expo": {
    "name": "Cetus",
    "slug": "cetus",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "cetus",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.hapadona.cetus"
    },
    "android": {
      "package": "com.hapadona.cetus"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cetus needs access to your photo library to set a profile avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
