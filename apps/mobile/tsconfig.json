{
  "extends": [
    "expo/tsconfig.base",
    "@cetus/config/tsconfig.base.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    // Restated from expo/tsconfig.base to pin the contract HPA-182 relies
    // on: bundler resolution honors package.json `exports`, and the
    // `react-native` custom condition selects *.native.tsx modules.
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    // Jest globals for __tests__ (repo convention: explicit types list).
    "types": ["jest"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts"
  ]
}
