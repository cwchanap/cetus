---
// NOTE: There is intentionally no `game-script` slot in this component.
// Astro does not bundle/hoist <script> tags placed inside named slots —
// the script is dropped during SSR slot rendering. Game init <script>s
// must live at the page root (outside GamePage), not in a slot.
// See commit 6c7f470 (L3b) for the bug this prevented.
import AppLayout from '@/layouts/AppLayout.astro'
import {
  GameBreadcrumb,
  GameControls,
  GameOverlay,
  GameStats,
  GameTitle,
} from '@cetus/ui'
import { cn } from '@/lib/utils'

interface Props {
  gameId: string
  title: string
  description: string
  icon: string
  navigation?: Array<{ href: string; label: string }>
  includeFooter?: boolean
  overlayTitle?: string
  overlayButtonText?: string
  overlayButtonId?: string
  showScore?: boolean
  showTime?: boolean
  showPause?: boolean
  showReset?: boolean
  showEnd?: boolean
  initialTime?: number
  class?: string
}

const {
  title,
  description,
  icon,
  navigation = [
    { href: '/', label: 'Home' },
    { href: '#', label: title },
  ],
  includeFooter = false,
  overlayTitle = 'Game Over',
  overlayButtonText = 'Play Again',
  overlayButtonId,
  showScore = true,
  showTime = true,
  showPause = true,
  showReset = true,
  showEnd = true,
  initialTime = 60,
  class: className,
} = Astro.props
---

<AppLayout
  title={`${title} - Cetus Minigames`}
  description={description}
  includeFooter={includeFooter}
  navigation={navigation}
>
  <!-- Game Breadcrumb -->
  <GameBreadcrumb icon={icon} title={title} />

  <div class={cn('px-6 py-8', className)}>
    <div class="max-w-6xl mx-auto">
      <!-- Game Title (React, SSR-only — no client: directive) -->
      <GameTitle title={title} description={description} />

      <!-- Game Container -->
      <div class="flex flex-col lg:flex-row gap-8 items-start justify-center">
        <!-- Main Game Board -->
        <div class="flex-shrink-0">
          <slot name="game-board" />
        </div>

        <!-- Game Sidebar -->
        <div class="flex flex-col space-y-6">
          <!-- Game Stats (React, SSR-only) -->
          <GameStats
            showScore={showScore}
            showTime={showTime}
            initialTime={initialTime}
          >
            <slot name="additional-stats" />
          </GameStats>

          <!-- Game Controls (React, SSR-only) -->
          {
            Astro.slots.has('controls') ? (
              <slot name="controls" />
            ) : (
              <GameControls
                showPause={showPause}
                showReset={showReset}
                showEnd={showEnd}
              />
            )
          }

          <!-- Game Information -->
          <slot name="game-info" />
        </div>
      </div>

      <!-- Bottom Information Section -->
      <slot name="bottom-info" />
    </div>

    <!-- Game Over Overlay -->
    <GameOverlay
      defaultTitle={overlayTitle}
      buttonText={overlayButtonText}
      buttonId={overlayButtonId}
      showScore={showScore}
    >
      <slot name="final-stats" />
    </GameOverlay>
  </div>
</AppLayout>
