---
import AppLayout from '@/layouts/AppLayout.astro'
import LeaderboardBoards from '@/components/islands/LeaderboardBoards'
import { Card, Container, Heading, Section } from '@cetus/ui'

// Server-side data fetching
import { getAllGames } from '@cetus/shared/games'
import {
  getGameLeaderboard,
  isGameLeaderboardAvailable,
} from '@/lib/server/db/queries'

// Fetch leaderboard data for each game and build the serializable island
// props. Score/date labels are formatted here (server locale) so the
// hydrated island renders identical markup to the server.
const games = getAllGames()
const boards = []

// Game icons mapping
const gameIcons: { [key: string]: string } = {
  tetris: '🔲',
  bubble_shooter: '🫧',
  quick_math: '🧮',
  memory_matrix: '🧠',
  word_scramble: '📝',
  reflex: '⚡',
  sudoku: '🧩',
  path_navigator: '🎮',
}

for (const game of games) {
  const result = await getGameLeaderboard(game.id, 10)
  // A failed score-context probe returns a discriminated `unavailable`
  // result (distinct from "no scores"). The page degrades to the existing
  // empty state rather than failing the whole render; the
  // `/api/leaderboard` endpoint surfaces the coded 503 for programmatic
  // callers.
  const leaderboard = isGameLeaderboardAvailable(result) ? result : []
  const highestScore =
    leaderboard.length > 0
      ? Math.max(...leaderboard.map(entry => entry.score))
      : 0

  boards.push({
    id: game.id,
    name: game.name,
    category: game.category,
    icon: gameIcons[game.id] || '🎮',
    highestScoreLabel: highestScore > 0 ? highestScore.toLocaleString() : null,
    entries: leaderboard.map(entry => ({
      name: entry.name,
      username: entry.username,
      scoreLabel: entry.score.toLocaleString(),
      dateLabel: new Date(entry.created_at).toLocaleDateString(),
      image: entry.image,
    })),
  })
}

const defaultGameId = games[0]?.id || 'tetris'
---

<AppLayout title="Leaderboards - Cetus Gaming Platform">
  <main class="relative z-10 min-h-screen">
    <Section className="py-20">
      <Container className="max-w-6xl">
        {/* Page Title */}
        <div class="mb-12">
          <div
            class="inline-flex items-center justify-center w-16 h-16 bg-cetus-accent/20 rounded-full mb-6"
          >
            <span class="text-2xl">🏆</span>
          </div>
          <Heading
            level={1}
            variant="hero"
            align="center"
            kicker="RANKINGS"
            className="text-4xl md:text-5xl font-bold mb-4"
          >
            Leaderboards
          </Heading>
          <p class="text-xl text-cetus-ink-muted max-w-2xl mx-auto">
            Compete for the top scores across all games. See who's dominating
            the leaderboard!
          </p>
        </div>

        <Card variant="glass" className="p-8">
          <!-- Selector + boards island: Astro passes only serializable board
               data fetched above; selection callbacks live in the island. -->
          <LeaderboardBoards
            client:load
            boards={boards}
            defaultGameId={defaultGameId}
          />
        </Card>
      </Container>
    </Section>
  </main>
</AppLayout>
