---
import AppLayout from '@/layouts/AppLayout.astro'
import IceSlideScreen from '@/components/islands/games/IceSlideScreen'
import type { IceSlidePlayableMode } from '@cetus/games/ice-slide/types'

// Legacy route behavior: the URL ?mode= query preselects a run mode, with
// anything unknown falling back to Campaign (SSR'd via defaultChecked so
// the pre-hydration markup already matches).
const requestedMode = Astro.url.searchParams.get('mode')
const initialMode: IceSlidePlayableMode =
  requestedMode === 'daily'
    ? 'daily'
    : requestedMode === 'expedition'
      ? 'expedition'
      : 'campaign'
---

<AppLayout
  title="Ice Slide - Cetus Minigames"
  description="Slide across slippery ice until you hit a wall — reach the goal in the fewest moves!"
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Ice Slide' },
  ]}
  includeFooter={false}
>
  <IceSlideScreen client:load initialMode={initialMode} />
</AppLayout>
