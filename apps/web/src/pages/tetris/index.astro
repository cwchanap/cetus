---
import AppLayout from '@/layouts/AppLayout.astro'
import AppNotifications from '@/components/islands/AppNotifications'
import TetrisScreen from '@/components/islands/games/TetrisScreen'
const user = Astro.locals.user
const instructions = [
  {
    image: 'line',
    alt: 'A complete row of blocks clears',
    label: 'Fill a row · It clears',
  },
  {
    image: 'ghost',
    alt: 'The outline of a T shows where it will land',
    label: 'Outline shows the landing',
  },
  {
    image: 'four',
    alt: 'The long form clears four rows at once',
    label: 'Four at once · ×30 score',
  },
]
const neighbours = [
  {
    href: '/bubble-shooter',
    number: 'II',
    name: 'Bubble Shooter',
    color: '#6fe3ff',
  },
  { href: '/bejeweled', number: 'III', name: 'Bejeweled', color: '#ff3d8a' },
  { href: '/ice-slide', number: 'XV', name: 'Ice Slide', color: '#6fe3ff' },
]
---

<AppLayout
  title="Tetris Challenge — Cetus"
  description="Stack the seven forms. Clear the rows. Keep the well open."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>
  <TetrisScreen client:load signedIn={Boolean(user)} />

  <Fragment slot="notifications">
    <dialog id="field-sheet" aria-labelledby="intro-title">
      <section id="intro-panel" data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. I · Specimen notes</span><span
            class="micro">Lattice · Seven forms</span
          >
        </div>
        <h2 id="intro-title">Tetris Challenge</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { amber: i === 2 }]}>
                    <span class:list={['accent', { amber: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="record-line">
          <span class="micro">{user ? 'Your best' : 'Best this visit'}</span
          ><span class="mono" data-best>—</span>
        </div>
        <p id="game-error" class="error-message hidden" role="alert">
          The plate could not be loaded. Refresh to try again.
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Loading the plate…</button
        >
        <div class="action-pair">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section id="pause-panel" data-panel="pause" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Starting level</p>
        <div class="action-pair" role="group" aria-label="Starting level">
          {
            [1, 5, 10].map(level => (
              <button
                class="secondary-action"
                data-level={level}
                aria-pressed={level === 1}
              >
                {level}
              </button>
            ))
          }
        </div>
        <p class="setting-note">
          Applies on the next dive. Higher levels drop faster and score more per
          line.
        </p>
        <div class="settings">
          <button id="ghost-btn" aria-pressed="true"
            ><span>Landing outline</span><span class="micro" data-state>On</span
            ></button
          >
          <button id="glyphs-btn" aria-pressed="false"
            ><span>Form letters</span><span class="micro" data-state>Off</span
            ></button
          >
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span class="micro" data-state>On</span></button
          >
          <button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span class="micro" data-state>Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button>
        <button id="reset-btn" class="secondary-action"
          >Abandon &amp; restart</button
        >
        <button id="end-btn" class="exit-action micro" style="display:none"
          >End dive</button
        >
        <p class="micro controls-hint">
          P resume · Arrows move · Space drop · C hold
        </p>
      </section>
      <section id="game-over-overlay" data-panel="results" class="hidden">
        <div class="sheet-kicker">
          <span class="micro">Dive record · Pl. I</span><span
            id="personal-best"
            class="micro new-best hidden">Personal best</span
          >
        </div>
        <h2 id="results-title">The stack won</h2>
        <div class="result-score">
          <div>
            <span class="micro">Score</span><div
              id="final-score"
              class="large-stat"
            >
              0
            </div>
          </div><div>
            <span class="micro">Reached</span><div class="stat-value ice">
              Level <span id="final-level">1</span>
            </div>
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Lines cleared</dt><dd id="final-lines">0</dd></div>
          <div><dt>Forms placed</dt><dd id="final-pieces">0</dd></div>
          <div>
            <dt>Longest clear streak</dt><dd id="final-streak" class="amber">
              ×0
            </dd>
          </div>
          <div>
            <dt>Points per form</dt><dd id="per-form" class="ice">—</dd>
          </div>
          <div><dt>Previous best</dt><dd id="previous-best">—</dd></div>
        </dl>
        <p class="micro settings-label">Clear breakdown</p>
        <div class="clear-breakdown">
          {
            ['Single', 'Double', 'Triple', 'Tetris'].map((label, i) => (
              <div
                class:list={[{ amber: i === 3, ice: i === 2, accent: i < 2 }]}
              >
                <>
                  <div class="clear-bar">
                    <span data-clear-bar={i} />
                  </div>
                  <p class="micro">{label}</p>
                  <span class="mono" data-clear-count={i}>
                    0
                  </span>
                </>
              </div>
            ))
          }
        </div>
        <div class="field-note">
          <span class="micro">Field note</span><p id="result-advice">
            Keep a well open on one side and feed it the long form.
          </p>
        </div>
        <p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={{ background: item.color }} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="play-again-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div>
        <h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { amber: i === 2 }]}>
                    <span class:list={['accent', { amber: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>One line</dt><dd>40 × level</dd></div>
          <div><dt>Four lines</dt><dd class="amber">1 200 × level</dd></div>
          <div><dt>Every 10 lines</dt><dd>Level up · Faster</dd></div>
          <div><dt>Hold</dt><dd>Once per form</dd></div>
        </dl>
        <p class="micro settings-label">Controls · Touch / Keys</p>
        <dl class="result-rows method-rows">
          <div><dt>Swipe sideways to move</dt><dd>← →</dd></div>
          <div><dt>Tap the plate to rotate</dt><dd>↑</dd></div>
          <div><dt>Soft drop</dt><dd>↓</dd></div>
          <div><dt>Swipe down to hard drop</dt><dd>Space</dd></div>
          <div><dt>Hold a form</dt><dd>C</dd></div>
          <div><dt>Pause the dive</dt><dd>P</dd></div>
        </dl>
        <button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Tetrises this visit</span><strong
              class="amber"
              id="visit-tetrises">0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user ? 'Saved scores & achievements ↗' : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In mid-water</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AppNotifications client:load />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>
<style is:global>
  /* The plate body moved into the TetrisScreen island (HPA-393);
     Astro-scoped selectors never match island-rendered elements, so
     the whole block is global (batch 1-3 precedent). Bare element
     selectors are scoped under their containers with :where() — the
     zero-specificity wrapper keeps the cascade (0,0,1)-equivalent
     for every plate node. Sheet coverage lists include both
     `.field-sheet` and `#field-sheet` (this route's dialog is
     id-only), and the sheet button legs exclude the notifications
     astro-island subtree via :where(:not(astro-island *)) so island
     chrome (#challenge-continue) keeps its own styles while static
     sheet buttons stay covered. */
  @font-face {
    font-family: 'Field Newsreader';
    src: url('/fonts/field-plate/newsreader.woff2') format('woff2');
    font-weight: 300 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Sans';
    src: url('/fonts/field-plate/plex-sans.woff2') format('woff2');
    font-weight: 400 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Mono';
    src: url('/fonts/field-plate/plex-mono.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  body[data-field-plate] {
    background: #04060a;
    color: #eaf6ff;
    font-family: 'Field Sans', sans-serif;
  }
  body[data-field-plate]::after {
    background-image: radial-gradient(
      rgba(234, 246, 255, 0.055) 0.5px,
      transparent 0.5px
    );
    background-size: 4px 4px;
    opacity: 0.5;
  }
  .plate-width {
    width: min(100%, 1000px);
    margin: 0 auto;
    padding-inline: 24px;
  }
  .plate-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-block: 22px 17px;
    position: relative;
  }
  .plate-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 24px;
    right: 24px;
    height: 4px;
    border-top: 1px solid #2e3e49;
    border-bottom: 1px solid #26333d;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    font:
      400 23px/1 'Field Newsreader',
      serif;
  }
  .brand-orb {
    width: 28px;
    height: 28px;
    border: 1px solid #2e3e49;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .brand-orb::after {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22f5d0;
  }
  :where(.plate-width) nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a {
    color: inherit;
    text-decoration: none;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:hover {
    color: #22f5d0;
  }
  .micro,
  .mono,
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    font-family: 'Field Mono', monospace;
  }
  .micro {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a98a6;
  }
  .mono {
    font-size: 13px;
  }
  .accent {
    color: #22f5d0;
  }
  .amber {
    color: #ffc24a;
  }
  .ice {
    color: #6fe3ff;
  }
  .urgent {
    color: #ff3d8a;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)),
  .account {
    border: 1px solid #26333d;
    border-radius: 2px;
    background: #0a1219;
    color: #a7b4bd;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    cursor: pointer;
  }
  :where(.plate-width) button:disabled,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):disabled {
    opacity: 0.45;
    cursor: default;
  }
  :where(.plate-width) button:hover:not(:disabled),
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):hover:not(:disabled) {
    border-color: #22f5d0;
    color: #eaf6ff;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:focus-visible,
  :where(.plate-width) button:focus-visible,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):focus-visible,
  #tetris-container canvas:focus-visible {
    outline: 2px solid #22f5d0;
    outline-offset: 3px;
  }
  .account {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 11px 4px 4px;
  }
  .account > span:first-child {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #22f5d0;
    color: #04060a;
    letter-spacing: 0;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px 14px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.28em;
  }
  :where(.plate-width) h1,
  :where(.field-sheet, #field-sheet) h2 {
    font-family: 'Field Newsreader', serif;
    font-weight: 400;
    line-height: 1.05;
  }
  :where(.plate-width) h1 {
    font-size: clamp(28px, 4vw, 38px);
    margin-top: 6px;
  }
  :where(.field-sheet, #field-sheet) h2 {
    font-size: 36px;
    font-weight: 300;
    margin-top: 12px;
  }
  :where(.field-sheet, #field-sheet) h2:focus {
    outline: none;
  }
  #pause-title,
  #log-title,
  #commission-title {
    font-size: 28px;
  }
  #results-title {
    font-size: 32px;
  }
  .tools {
    display: flex;
    gap: 6px;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    font-size: 14px;
  }
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 18px 34px;
    padding-block: 14px;
    border-block: 1px solid #26333d;
  }
  .score-stat {
    min-width: 120px;
  }
  .large-stat {
    font:
      400 clamp(38px, 6.5vw, 52px) / 1 'Field Newsreader',
      serif;
    letter-spacing: -0.01em;
  }
  :where(.plate-width, .field-sheet, #field-sheet) progress {
    display: block;
    width: 100%;
    height: 7px;
    border: 1px solid #26333d;
    background: #0a1219;
    color: #22f5d0;
    appearance: none;
  }
  :where(.plate-width, .field-sheet, #field-sheet)
    progress::-webkit-progress-bar {
    background: #0a1219;
  }
  :where(.plate-width, .field-sheet, #field-sheet)
    progress::-webkit-progress-value {
    background: currentColor;
  }
  :where(.plate-width, .field-sheet, #field-sheet) progress::-moz-progress-bar {
    background: currentColor;
  }
  .small-stats {
    display: flex;
    gap: 22px;
    padding-bottom: 6px;
  }
  .stat-value {
    font:
      15px 'Field Mono',
      monospace;
    margin-top: 4px;
  }
  .descent {
    flex: 1 1 210px;
    min-width: 186px;
    padding-bottom: 4px;
  }
  .descent-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  #rate-fill {
    margin-top: 7px;
  }
  .chain-note {
    margin-top: 7px;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  .field-plate {
    padding-bottom: 40px;
  }
  .play-area {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 14px;
    padding-top: 18px;
  }
  .piece-trays {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 150px;
  }
  .piece-tray {
    padding: 10px;
    border: 1px solid #26333d;
    background: #0a1219;
    text-align: left;
    width: 100%;
  }
  .piece-tray canvas {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 8px;
    background: #070b16;
  }
  #hold-btn:disabled {
    opacity: 1;
    cursor: default;
  }
  #hold-btn:disabled #hold-state {
    color: #8a98a6;
  }
  .plate-frame {
    position: relative;
    padding: 10px;
    border: 1px solid #2e3e49;
    background: #0a1219;
  }
  .corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: #22f5d0;
    border-style: solid;
    border-width: 0;
  }
  .top-left {
    top: 4px;
    left: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .top-right {
    top: 4px;
    right: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .bottom-left {
    bottom: 4px;
    left: 4px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .bottom-right {
    bottom: 4px;
    right: 4px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  #tetris-container {
    height: min(clamp(380px, 66vh, 640px), calc((100vw - 70px) * 2));
    aspect-ratio: 1/2;
    max-width: calc(100vw - 70px);
    background: linear-gradient(#0b1426, #070b16);
  }
  #tetris-container canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    touch-action: none;
    cursor: pointer;
  }
  #clear-flash {
    position: absolute;
    inset: 10px;
    display: grid;
    grid-template-rows: repeat(20, 1fr);
    pointer-events: none;
  }
  #clear-flash span {
    opacity: 0;
    background: #eaf6ff;
  }
  #clear-flash .flash {
    animation: clear-row 350ms ease-out;
  }
  @keyframes clear-row {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
    }
  }
  #line-feedback {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translateX(-50%);
