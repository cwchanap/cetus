---
import AppLayout from '@/layouts/AppLayout.astro'
import PotionSorterScreen from '@/components/islands/games/PotionSorterScreen'
---

<AppLayout
  title="Potion Sorter - Cetus Minigames"
  description="Sort layered lab potions into matching tubes before time runs out"
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Potion Sorter' },
  ]}
  includeFooter={false}
>
  <PotionSorterScreen client:load />
</AppLayout>

<style is:global>
  /* Selected difficulty mirrors the React Button `primary` variant from
     @cetus/ui (same contract as Mine Grid, carried over from Button.astro):
     `aria-pressed` drives both a11y state and styling, so initFramework
     only toggles the attribute. The difficulty buttons are rendered by the
     PotionSorterScreen island, so these selectors must stay global. */
  @reference "../../styles/global.css";
  .potion-sorter-difficulty[aria-pressed='true'] {
    @apply border-0 bg-gradient-to-r from-[var(--cetus-btn-from)] to-[var(--cetus-btn-to)] text-white shadow-lg shadow-cetus-accent-2/25 hover:from-cetus-accent hover:to-cetus-accent-2;
  }

  /* Board: flex-wrap keeps DOM order (tube index) reading left→right,
     top→bottom, and lets nine tubes wrap to two rows at 375px. */
  .potion-sorter-board {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  /* Tube buttons are static island markup; PotionSorterRenderer only toggles
     their hidden state and data attributes. All visual affordance lives here,
     keyed by the data attributes the renderer emits. */
  .potion-tube[hidden],
  .potion-layer[hidden] {
    display: none;
  }
  .potion-tube {
    display: flex;
    flex-direction: column-reverse; /* tube array index 0 renders at the bottom */
    flex: 0 1 3.5rem;
    min-width: 3rem; /* ≥48px touch target */
    height: 11.5rem;
    padding: 0.25rem;
    gap: 2px;
    border-radius: 0.5rem 0.5rem 1.25rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--cetus-accent) 35%, transparent);
    background: color-mix(in srgb, var(--cetus-accent) 6%, transparent);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .potion-tube:hover {
    border-color: var(--cetus-accent);
  }
  .potion-tube:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
  }
  .potion-tube[data-selected='true'] {
    border-color: var(--cetus-accent-2);
    box-shadow: 0 0 16px
      color-mix(in srgb, var(--cetus-accent-2) 40%, transparent);
    transform: translateY(-4px);
  }
  .potion-tube[data-complete='true'] {
    border-color: var(--cetus-accent-3);
    box-shadow: 0 0 12px
      color-mix(in srgb, var(--cetus-accent-3) 35%, transparent);
  }

  /* Liquid layers: `data-liquid` keys the color; the glyph textContent
     (▲ ● ◆ ✦ ⬢ ■ ✚) stays visible as the layer's marker. */
  .potion-layer {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    line-height: 1;
    color: #06131f;
  }
  .potion-layer[data-liquid='cyan'] {
    background: #22d3ee;
  }
  .potion-layer[data-liquid='magenta'] {
    background: #e879f9;
  }
  .potion-layer[data-liquid='amber'] {
    background: #fbbf24;
  }
  .potion-layer[data-liquid='lime'] {
    background: #a3e635;
  }
  .potion-layer[data-liquid='violet'] {
    background: #a78bfa;
  }
  .potion-layer[data-liquid='coral'] {
    background: #fb7185;
  }
  .potion-layer[data-liquid='azure'] {
    background: #60a5fa;
  }

  /* Dead-end emphasis: initFramework toggles data-dead-end. */
  #undo-btn[data-dead-end='true'] {
    border-width: 2px;
    font-weight: 700;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .potion-tube {
      transition: none;
    }
    .potion-tube[data-selected='true'] {
      transform: none;
    }
  }
</style>
