---
import AppLayout from '@/layouts/AppLayout.astro'
import EvaderScreen from '@/components/islands/games/EvaderScreen'
---

<AppLayout
  title="Evader - Cetus Minigames"
  description="Move in all directions to collect coins (+100) and avoid bombs (-100) in 60 seconds!"
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Evader' },
  ]}
  includeFooter={false}
>
  <EvaderScreen client:load />
</AppLayout>

<style is:global>
  /* Static D-pad markup lives in the EvaderScreen island (HPA-393), so
     these selectors must be global — Astro-scoped styles would never match
     island-rendered elements. */
  /* Hide the touch D-pad on devices with a fine pointer (desktop/mouse). */
  @media (hover: hover) and (pointer: fine) {
    #dpad {
      display: none;
    }
  }

  .dpad-btn {
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    border-radius: 0.75rem;
    border: 2px solid color-mix(in oklab, var(--cetus-accent) 50%, transparent);
    background: color-mix(in oklab, var(--cetus-accent) 8%, transparent);
    color: var(--cetus-accent);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition:
      background 0.1s,
      border-color 0.1s,
      box-shadow 0.1s;
  }

  .dpad-btn:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
    box-shadow: 0 0 12px
      color-mix(in oklab, var(--cetus-accent) 45%, transparent);
  }

  .dpad-btn:active,
  .dpad-btn.active {
    background: color-mix(in oklab, var(--cetus-accent) 35%, transparent);
    border-color: var(--cetus-accent);
    box-shadow: 0 0 18px
      color-mix(in oklab, var(--cetus-accent) 55%, transparent);
  }
</style>
