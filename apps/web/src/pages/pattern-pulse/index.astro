---
import AppLayout from '@/layouts/AppLayout.astro'
import PatternPulseScreen from '@/components/islands/games/PatternPulseScreen'
---

<AppLayout
  title="Pattern Pulse - Cetus Minigames"
  description="Watch the signal, then repeat the growing pattern before time runs out"
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Pattern Pulse' },
  ]}
  includeFooter={false}
>
  <PatternPulseScreen client:load />
</AppLayout>

<style is:global>
  /* Static pads live in the PatternPulseScreen island (HPA-393), so these
     selectors must be global — Astro-scoped styles would never match
     island-rendered elements. The renderer only toggles data attributes,
     so all visual affordance lives here. Pads are never natively disabled
     — [aria-disabled='true'] keys the gated treatment. */
  .pattern-pulse-pad {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    color: var(--cetus-accent);
    background: color-mix(in srgb, var(--cetus-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cetus-accent) 25%, transparent);
    transition:
      transform 80ms ease,
      border-color 80ms ease,
      background-color 80ms ease,
      box-shadow 80ms ease;
  }
  .pattern-pulse-pad[aria-disabled='false']:hover {
    background: color-mix(in srgb, var(--cetus-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--cetus-accent) 50%, transparent);
  }
  .pattern-pulse-pad:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
  }
  .pattern-pulse-pad[data-active='true'] {
    transform: scale(1.04);
    background: color-mix(in srgb, var(--cetus-accent) 32%, transparent);
    border-color: var(--cetus-accent);
    box-shadow: 0 0 24px
      color-mix(in srgb, var(--cetus-accent) 45%, transparent);
  }
  .pattern-pulse-pad[data-feedback='wrong'] {
    color: var(--cetus-accent-3);
    background: color-mix(in srgb, var(--cetus-accent-3) 22%, transparent);
    border-color: var(--cetus-accent-3);
  }
  .pattern-pulse-pad[aria-disabled='true'] {
    cursor: default;
    opacity: 0.75;
  }
  #pattern-status {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.2em;
    color: var(--cetus-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .pattern-pulse-pad {
      transition: none;
    }
    .pattern-pulse-pad[data-active='true'] {
      transform: none;
    }
  }
</style>
