---
import AppLayout from '@/layouts/AppLayout.astro'
import RhythmReactorScreen from '@/components/islands/games/RhythmReactorScreen'
---

<AppLayout
  title="Rhythm Reactor - Cetus Minigames"
  description="Hit each falling beat in time to keep the reactor stable."
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Rhythm Reactor' },
  ]}
  includeFooter={false}
>
  <RhythmReactorScreen client:load />
</AppLayout>

<style is:global>
  /* Static canvas + lane-button markup lives in the RhythmReactorScreen
     island (HPA-393), so these selectors must be global — Astro-scoped
     styles would never match island-rendered elements. */
  #rhythm-reactor-canvas canvas {
    display: block;
    max-width: 100%;
    height: auto;
    touch-action: manipulation;
  }
  .rhythm-lane-button {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    color: var(--cetus-accent);
    background: color-mix(in srgb, var(--cetus-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cetus-accent) 25%, transparent);
    transition:
      background-color 80ms ease,
      border-color 80ms ease;
  }
  .rhythm-lane-button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--cetus-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--cetus-accent) 50%, transparent);
  }
  .rhythm-lane-button:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
  }
  .rhythm-lane-button:disabled {
    cursor: default;
    opacity: 0.6;
  }
</style>
