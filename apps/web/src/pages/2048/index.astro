---
import AppLayout from '@/layouts/AppLayout.astro'
import AppNotifications from '@/components/islands/AppNotifications'
import Game2048Screen from '@/components/islands/games/Game2048Screen'
const user = Astro.locals.user
const instructions = [
  {
    image: 'slide',
    alt: 'All tiles slide to the left',
    label: 'Swipe · Every tile slides',
  },
  {
    image: 'merge',
    alt: 'Two tiles marked 2 join into a tile marked 4',
    label: 'Equals join · 2 + 2 = 4',
  },
  {
    image: 'goal',
    alt: 'The pink 2048 tile',
    label: 'Reach 2048 · Then keep going',
  },
]
const neighbours = [
  { href: '/tetris', number: 'I', name: 'Tetris Challenge', color: '#22f5d0' },
  { href: '/bejeweled', number: 'III', name: 'Bejeweled', color: '#ff3d8a' },
  { href: '/sudoku', number: 'VIII', name: 'Sudoku', color: '#ffc24a' },
]
---

<AppLayout
  title="2048 — Cetus"
  description="Slide the tiles. Join equals. Reach 2048, then keep diving."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>

  <Game2048Screen client:load signedIn={Boolean(user)} />

  <Fragment slot="notifications">
    <dialog id="field-sheet" data-panel="intro" aria-labelledby="intro-title">
      <section data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. XII · Specimen notes</span><span
            class="micro">Cluster · Powers of two</span
          >
        </div>
        <h2 id="intro-title">2048</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { urgent: i === 2 }]}>
                    <span class:list={['accent', { urgent: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="best-box">
          <span class="micro">Your best</span><span class="mono" data-best
            >—</span
          >
        </div>
        <p id="load-status" class="description" role="status">
          Preparing the plate…
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Begin the dive</button
        >
        <div class="sheet-actions">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section data-panel="pause" id="pause-panel" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Undos per dive</p><div
          class="undo-choices"
          role="group"
          aria-label="Undos per dive"
        >
          {
            [0, 1, 3].map((value, i) => (
              <button data-undos={value} aria-pressed={value === 1}>
                {['None', 'One', 'Three'][i]}
              </button>
            ))
          }
        </div>
        <p class="description">
          Applies next dive. Undos used are noted in the field log.
        </p>
        <div class="settings">
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span id="sound-state" class="micro">On</span
            ></button
          ><button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span id="motion-state" class="micro"
              >Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button><button
          class="secondary-action"
          data-sheet="log">Field log</button
        ><button id="reset-btn" class="secondary-action"
          >Abandon & restart</button
        ><button id="end-btn" class="text-action">End dive</button>
      </section>
      <section data-panel="win" class="hidden">
        <div class="win-tile">2048</div><p class="micro urgent settings-label">
          Specimen of record
        </p><h2 id="win-title">The deep gave it up</h2><p
          id="win-line"
          class="micro description"
        >
        </p>
        <button id="keep-playing-btn" class="primary-action"
          >Keep diving → 4096</button
        ><button data-end class="secondary-action">Surface & log it</button>
      </section>
      <section data-panel="stuck" class="hidden">
        <p class="micro amber">No moves left</p><h2 id="stuck-title">
          The bed has set
        </h2><p class="description">
          You have an undo left — step back and try another direction.
        </p>
        <button id="undo-stuck-btn" class="primary-action"
          >↶ Undo last move</button
        ><button data-end class="secondary-action">End the dive</button>
      </section>
      <section data-panel="results" id="game-over-overlay" class="hidden">
        <span id="personal-best" class="best-stamp hidden">Personal best</span
        ><p class="micro">Dive record · Pl. XII</p><h2 id="results-title">
          The bed set early
        </h2>
        <div class="result-heading">
          <div id="final-max-tile" class="result-tile">2</div><div>
            <span class="micro">Score</span><strong id="custom-final-score"
              >0</strong
            >
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Moves made</dt><dd id="final-moves">0</dd></div><div>
            <dt>Merges</dt><dd id="final-merges">0</dd>
          </div><div>
            <dt>Points per move</dt><dd id="points-per-move" class="ice">—</dd>
          </div><div><dt>Undos used</dt><dd id="final-undos">0</dd></div><div>
            <dt>Previous best</dt><dd id="previous-best">0</dd>
          </div>
        </dl>
        <div class="field-note">
          <span class="micro">Field note</span><p id="result-advice"></p>
        </div><p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={`background:${item.color}`} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="restart-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div><h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { urgent: i === 2 }]}>
                    <span class:list={['accent', { urgent: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>A merge scores</dt><dd>The new tile’s value</dd></div><div>
            <dt>Each tile</dt><dd>Joins once per move</dd>
          </div>
        </dl>
        <p class="micro settings-label">Controls · Touch / Keys</p><dl
          class="result-rows method-rows"
        >
          <div><dt>Swipe the plate to slide</dt><dd>← ↑ ↓ →</dd></div><div>
            <dt>Also move with</dt><dd>W A S D</dd>
          </div><div><dt>Step back one move</dt><dd>U</dd></div><div>
            <dt>Pause the dive</dt><dd>P</dd>
          </div>
        </dl><button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Highest tile this visit</span><strong
              class="amber"
              id="visit-tile">0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user ? 'Saved scores & achievements ↗' : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In mid-water</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AppNotifications client:load />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>

<style is:global>
  /* The plate body moved into the Game2048Screen island (HPA-393);
     Astro-scoped selectors never match island-rendered elements, so
     the whole block is global (batch 1-3 precedent). Bare element
     selectors are scoped under their containers with :where() — the
     zero-specificity wrapper keeps the cascade (0,0,1)-equivalent
     for every plate node. Sheet coverage lists include both
     `.field-sheet` and `#field-sheet` (this route's dialog is
     id-only), and the sheet button legs exclude the notifications
     astro-island subtree via :where(:not(astro-island *)) so island
     chrome (#challenge-continue) keeps its own styles while static
     sheet buttons stay covered. */
  #field-sheet[data-reduced-motion='true'] *,
  #field-sheet[data-reduced-motion='true'] *::before,
  #field-sheet[data-reduced-motion='true'] *::after {
    animation: none !important;
    transition: none !important;
  }
  :where(.field-sheet, #field-sheet) h2:focus {
    outline: none;
  }
  @font-face {
    font-family: 'Field Display';
    src: url('/fonts/field-plate/newsreader.woff2') format('woff2');
    font-weight: 300 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Sans';
    src: url('/fonts/field-plate/plex-sans.woff2') format('woff2');
    font-weight: 400 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Mono';
    src: url('/fonts/field-plate/plex-mono.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  body[data-field-plate] {
    background: #04060a;
    color: #eaf6ff;
    font-family: 'Field Sans', sans-serif;
  }
  body[data-field-plate]::after {
    background-image: radial-gradient(
      rgba(234, 246, 255, 0.055) 0.5px,
      transparent 0.5px
    );
    background-size: 4px 4px;
    opacity: 0.5;
  }
  .plate-width {
    width: min(100%, 1000px);
    margin: auto;
    padding-inline: 24px;
  }
  .plate-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-block: 22px 18px;
    position: relative;
  }
  .plate-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 24px;
    right: 24px;
    height: 4px;
    border-top: 1px solid #2e3e49;
    border-bottom: 1px solid #26333d;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    font:
      400 23px/1 'Field Display',
      serif;
  }
  .brand-orb {
    width: 28px;
    height: 28px;
    border: 1px solid #2e3e49;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .brand-orb::after {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22f5d0;
  }
  :where(.plate-width) nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a {
    color: inherit;
    text-decoration: none;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:hover {
    color: #22f5d0;
  }
  .micro,
  .mono,
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    font-family: 'Field Mono', monospace;
  }
  .micro {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a98a6;
  }
  .mono {
    font-size: 13px;
  }
  .accent {
    color: #22f5d0;
  }
  .amber {
    color: #ffc24a;
  }
  .ice {
    color: #6fe3ff;
  }
  .urgent {
    color: #ff3d8a;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)),
  .account {
    border: 1px solid #26333d;
    border-radius: 2px;
    background: #0a1219;
    color: #a7b4bd;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    cursor: pointer;
  }
  :where(.plate-width) button:disabled,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):disabled {
    opacity: 0.4;
    cursor: default;
  }
  :where(.plate-width) button:hover:not(:disabled),
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):hover:not(:disabled) {
    border-color: #22f5d0;
    color: #eaf6ff;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:focus-visible,
  :where(.plate-width) button:focus-visible,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):focus-visible,
  #game-2048-container canvas:focus-visible {
    outline: 2px solid #22f5d0;
    outline-offset: 3px;
  }
  .account {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 11px 4px 4px;
  }
  .account > span:first-child {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #22f5d0;
    color: #04060a;
    letter-spacing: 0;
  }
  .field-plate {
    padding-bottom: 40px;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px 14px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.28em;
  }
  :where(.plate-width) h1,
  :where(.field-sheet, #field-sheet) h2 {
    font-family: 'Field Display', serif;
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
  }
  :where(.plate-width) h1 {
    font-size: clamp(28px, 4vw, 38px);
    margin-top: 6px;
  }
  :where(.field-sheet, #field-sheet) h2 {
    font-size: 28px;
    margin-top: 8px;
  }
  :where(.plate-width, .field-sheet, #field-sheet) p {
    margin: 0;
  }
  .tools {
    display: flex;
    gap: 6px;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    font-size: 16px;
  }
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 18px 34px;
    padding: 14px 0;
    border-block: 1px solid #26333d;
  }
  .score-stat {
    min-width: 120px;
  }
  :where(.plate-width) nav > .micro {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #a7b4bd;
  }
  :where(.plate-width) nav > .account {
    letter-spacing: 0.1em;
  }
  .score-stat > span,
  .best-stat > span {
    display: block;
  }
  .score-stat > span {
    letter-spacing: 0.28em;
  }
  .score-stat strong {
    font:
      400 clamp(38px, 6.5vw, 52px) / 1 'Field Display',
      serif;
    letter-spacing: -0.01em;
  }
  .best-stat {
    padding-bottom: 6px;
  }
  .best-stat strong {
    display: block;
    margin-top: 4px;
    font:
      15px 'Field Mono',
      monospace;
  }
  .ascent {
    flex: 1 1 230px;
    min-width: 200px;
    padding-bottom: 4px;
  }
  .ascent .micro {
    font-size: 9px;
  }
  .ascent #next-target {
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .record-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .ladder {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  .ladder span {
    flex: 1;
    height: 6px;
    border: 1px solid #26333d;
  }
  .ladder span:first-child {
    border-color: #22f5d0;
  }
  .play-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 18px;
  }
  .board-frame {
    position: relative;
    width: min(100%, 472px);
    padding: 10px;
    border: 1px solid #2e3e49;
    background: #0a1219;
  }
  .board-frame > i {
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: #22f5d0;
    border-style: solid;
    border-width: 0;
    pointer-events: none;
  }
  .board-frame > i:nth-child(1) {
    top: 4px;
    left: 4px;
    border-left-width: 1px;
    border-top-width: 1px;
  }
  .board-frame > i:nth-child(2) {
    top: 4px;
    right: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
  }
  .board-frame > i:nth-child(3) {
    bottom: 4px;
    left: 4px;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }
  .board-frame > i:nth-child(4) {
    bottom: 4px;
    right: 4px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }
  #game-2048-container {
    aspect-ratio: 1;
    background: linear-gradient(#0b1426, #070b16);
    touch-action: none;
    cursor: grab;
  }
  #game-2048-container canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    touch-action: none;
  }
  .board-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 472px);
    min-height: 44px;
    margin-top: 10px;
  }
  #board-warning {
    flex: 1;
    min-width: 0;
    letter-spacing: 0.12em;
  }
  .undo-button {
    min-height: 44px;
    padding: 0 14px;
    background: transparent;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  #merge-feedback {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    color: #22f5d0;
    font-size: 21px;
    pointer-events: none;
    white-space: nowrap;
  }
  dialog:where(.field-sheet, #field-sheet) {
    position: fixed;
    inset: 0;
    width: calc(100% - 40px);
    max-width: 430px;
    max-height: calc(100dvh - 40px);
    margin: auto;
    padding: 26px;
    border: 1px solid #2e3e49;
    background: #0a1219;
    color: #eaf6ff;
    overflow: auto;
    font-family: 'Field Sans', sans-serif;
  }
  dialog:where(.field-sheet, #field-sheet)::backdrop {
    background: rgba(2, 4, 8, 0.9);
  }
  dialog:where(.field-sheet, #field-sheet)[data-panel='pause'],
  dialog:where(.field-sheet, #field-sheet)[data-panel='help'],
  dialog:where(.field-sheet, #field-sheet)[data-panel='commission'] {
    max-width: 410px;
    padding: 24px;
  }
  dialog:where(.field-sheet, #field-sheet)[data-panel='win'],
  dialog:where(.field-sheet, #field-sheet)[data-panel='stuck'] {
    max-width: 400px;
    padding: 24px;
  }
