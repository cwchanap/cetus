---
import AppLayout from '@/layouts/AppLayout.astro'
import AchievementAward from '@/components/AchievementAward.astro'
import ChallengeComplete from '@/components/ChallengeComplete.astro'
const user = Astro.locals.user
const instructions = [
  {
    image: 'slide',
    alt: 'All tiles slide to the left',
    label: 'Swipe · Every tile slides',
  },
  {
    image: 'merge',
    alt: 'Two tiles marked 2 join into a tile marked 4',
    label: 'Equals join · 2 + 2 = 4',
  },
  {
    image: 'goal',
    alt: 'The pink 2048 tile',
    label: 'Reach 2048 · Then keep going',
  },
]
const neighbours = [
  { href: '/tetris', number: 'I', name: 'Tetris Challenge', color: '#22f5d0' },
  { href: '/bejeweled', number: 'III', name: 'Bejeweled', color: '#ff3d8a' },
  { href: '/sudoku', number: 'VIII', name: 'Sudoku', color: '#ffc24a' },
]
const ladder = [64, 128, 256, 512, 1024, 2048, 4096]
---

<AppLayout
  title="2048 — Cetus"
  description="Slide the tiles. Join equals. Reach 2048, then keep diving."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>

  <div class="plate-width field-plate" data-signed-in={Boolean(user)}>
    <div class="title-row">
      <div>
        <p class="micro accent eyebrow">Pl. XII — Mid-water · 200–1 000 m</p><h1
        >
          2048
        </h1>
      </div>
      <div class="tools">
        <button
          class="icon-button"
          data-sheet="commission"
          aria-label="Today's commission"
          title="Today's commission">⭐</button
        >
        <button
          class="icon-button"
          data-sheet="help"
          aria-label="How it plays"
          title="How it plays">?</button
        >
        <button
          class="icon-button"
          id="pause-btn"
          aria-label="Pause"
          title="Pause (P)"
          disabled>Ⅱ</button
        >
      </div>
    </div>
    <div class="hud" aria-label="Dive statistics">
      <div class="score-stat">
        <span class="micro">Score</span><strong id="score-display">0</strong>
      </div>
      <div class="best-stat">
        <span class="micro">Best</span><strong data-best>—</strong>
      </div>
      <div class="ascent">
        <div class="record-line">
          <span class="micro">Ascent</span><span
            id="next-target"
            class="micro accent">Next · 64</span
          >
        </div>
        <div class="ladder" aria-label="Highest tile milestones">
          {
            ladder.map(value => (
              <span
                data-milestone={value}
                title={String(value)}
                aria-label={String(value)}
              />
            ))
          }
        </div>
      </div>
    </div>
    <div class="play-area">
      <div class="board-frame">
        <i aria-hidden="true"></i><i aria-hidden="true"></i><i
          aria-hidden="true"></i><i aria-hidden="true"></i>
        <div id="game-2048-container"></div><div
          id="merge-feedback"
          class="mono"
          aria-hidden="true"
        >
        </div>
      </div>
      <div class="board-footer">
        <p id="board-warning" class="micro amber"></p><button
          id="undo-btn"
          class="undo-button"
          title="Step back one move (U)"
          disabled>↶ Undo · <span id="undos-left">1</span></button
        >
      </div>
      <p
        id="game-status"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
    </div>
  </div>
  <Fragment slot="notifications">
    <dialog id="field-sheet" data-panel="intro" aria-labelledby="intro-title">
      <section data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. XII · Specimen notes</span><span
            class="micro">Cluster · Powers of two</span
          >
        </div>
        <h2 id="intro-title">2048</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { urgent: i === 2 }]}>
                    <span class:list={['accent', { urgent: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="best-box">
          <span class="micro">Your best</span><span class="mono" data-best
            >—</span
          >
        </div>
        <p id="load-status" class="description" role="status">
          Preparing the plate…
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Begin the dive</button
        >
        <div class="sheet-actions">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section data-panel="pause" id="pause-panel" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Undos per dive</p><div
          class="undo-choices"
          role="group"
          aria-label="Undos per dive"
        >
          {
            [0, 1, 3].map((value, i) => (
              <button data-undos={value} aria-pressed={value === 1}>
                {['None', 'One', 'Three'][i]}
              </button>
            ))
          }
        </div>
        <p class="description">
          Applies next dive. Undos used are noted in the field log.
        </p>
        <div class="settings">
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span id="sound-state" class="micro">On</span
            ></button
          ><button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span id="motion-state" class="micro"
              >Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button><button
          class="secondary-action"
          data-sheet="log">Field log</button
        ><button id="reset-btn" class="secondary-action"
          >Abandon & restart</button
        ><button id="end-btn" class="text-action">End dive</button>
      </section>
      <section data-panel="win" class="hidden">
        <div class="win-tile">2048</div><p class="micro urgent settings-label">
          Specimen of record
        </p><h2 id="win-title">The deep gave it up</h2><p
          id="win-line"
          class="micro description"
        >
        </p>
        <button id="keep-playing-btn" class="primary-action"
          >Keep diving → 4096</button
        ><button data-end class="secondary-action">Surface & log it</button>
      </section>
      <section data-panel="stuck" class="hidden">
        <p class="micro amber">No moves left</p><h2 id="stuck-title">
          The bed has set
        </h2><p class="description">
          You have an undo left — step back and try another direction.
        </p>
        <button id="undo-stuck-btn" class="primary-action"
          >↶ Undo last move</button
        ><button data-end class="secondary-action">End the dive</button>
      </section>
      <section data-panel="results" id="game-over-overlay" class="hidden">
        <span id="personal-best" class="best-stamp hidden">Personal best</span
        ><p class="micro">Dive record · Pl. XII</p><h2 id="results-title">
          The bed set early
        </h2>
        <div class="result-heading">
          <div id="final-max-tile" class="result-tile">2</div><div>
            <span class="micro">Score</span><strong id="custom-final-score"
              >0</strong
            >
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Moves made</dt><dd id="final-moves">0</dd></div><div>
            <dt>Merges</dt><dd id="final-merges">0</dd>
          </div><div>
            <dt>Points per move</dt><dd id="points-per-move" class="ice">—</dd>
          </div><div><dt>Undos used</dt><dd id="final-undos">0</dd></div><div>
            <dt>Previous best</dt><dd id="previous-best">0</dd>
          </div>
        </dl>
        <div class="field-note">
          <span class="micro">Field note</span><p id="result-advice"></p>
        </div><p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={`background:${item.color}`} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="restart-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div><h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <canvas
                    class="rule-figure"
                    data-fig={item.image}
                    width="300"
                    height="200"
                    role="img"
                    aria-label={item.alt}
                  />
                  <figcaption class:list={['micro', { urgent: i === 2 }]}>
                    <span class:list={['accent', { urgent: i === 2 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>A merge scores</dt><dd>The new tile’s value</dd></div><div>
            <dt>Each tile</dt><dd>Joins once per move</dd>
          </div>
        </dl>
        <p class="micro settings-label">Controls · Touch / Keys</p><dl
          class="result-rows method-rows"
        >
          <div><dt>Swipe the plate to slide</dt><dd>← ↑ ↓ →</dd></div><div>
            <dt>Also move with</dt><dd>W A S D</dd>
          </div><div><dt>Step back one move</dt><dd>U</dd></div><div>
            <dt>Pause the dive</dt><dd>P</dd>
          </div>
        </dl><button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Highest tile this visit</span><strong
              class="amber"
              id="visit-tile">0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user ? 'Saved scores & achievements ↗' : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In mid-water</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AchievementAward /><ChallengeComplete />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>

<script>
  import {
    init2048GameFramework,
    type Game2048InitResult,
  } from '@/lib/games/2048/initFramework'
  import type {
    Game2048State,
    Game2048Stats,
  } from '@/lib/games/2048/frameworkTypes'
  import { getTileColor, getTileTextColor } from '@/lib/games/2048/utils'
  import { getUserBestScore } from '@/lib/services/scoreService'
  import { GameID } from '@cetus/shared/games'
  import type { UserChallengeProgress } from '@cetus/shared/challenges'

  const sheet = document.querySelector<HTMLDialogElement>('#field-sheet')!
  const panels = [...sheet.querySelectorAll<HTMLElement>('[data-panel]')]
  const startButton = document.querySelector<HTMLButtonElement>('#start-btn')!
  const pauseButton = document.querySelector<HTMLButtonElement>('#pause-btn')!
  const undoButton = document.querySelector<HTMLButtonElement>('#undo-btn')!
  const signedIn =
    document.querySelector<HTMLElement>('.field-plate')!.dataset.signedIn ===
    'true'
  const setText = (id: string, value: string | number) => {
    document.getElementById(id)!.textContent = String(value)
  }
  const hex = (value: number) => '#' + value.toString(16).padStart(6, '0')
  let handle: Game2048InitResult | undefined
  let currentPanel = 'intro'
  let returnPanel = 'intro'
  let resumeAfterSheet = false
  let savedBest: number | null = signedIn ? null : 0
  let visitBest = 0
  let lastResult: { score: number; previousBest: number } | null = null
  let visits = 0
  let visitTile = 0
  let previousScore = 0
  let previousMax = 0
  let previousWon = false
  let previousUndosUsed = 0
  let sound = true
  let reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
  let audio: AudioContext | undefined
  const controller = new AbortController()
  const { signal } = controller
  const syncBest = () => {
    const best = savedBest === null ? null : Math.max(savedBest, visitBest)
    document.querySelectorAll('[data-best]').forEach(el => {
      el.textContent = best === null ? '—' : best.toLocaleString()
    })
    setText(
      'previous-best',
      savedBest === null
        ? '—'
        : Math.max(savedBest, lastResult?.previousBest ?? 0).toLocaleString()
    )
    document
      .getElementById('personal-best')!
      .classList.toggle(
        'hidden',
        savedBest === null ||
          lastResult === null ||
          lastResult.score <= Math.max(savedBest, lastResult.previousBest)
      )
  }
  const showSheet = (panel: string) => {
    currentPanel = panel
    panels.forEach(el =>
      el.classList.toggle('hidden', el.dataset.panel !== panel)
    )
    sheet.dataset.panel = panel
    sheet.setAttribute(
      'aria-labelledby',
      `${panel === 'intro' ? 'intro' : panel}-title`
    )
    if (!sheet.open) {
      sheet.showModal()
    }
    const heading = sheet.querySelector<HTMLElement>(
      `:scope > [data-panel="${panel}"] h2`
    )!
    heading.tabIndex = -1
    heading.focus({ preventScroll: true })
    sheet.scrollTop = 0
  }
  const closeSheet = () => {
    currentPanel = ''
    sheet.close()
    handle?.renderer.getApp()?.canvas.focus({ preventScroll: true })
  }
  const closeInfo = () => {
    if (resumeAfterSheet) {
      resumeAfterSheet = false
      handle?.game.resume()
    } else if (returnPanel) {
      showSheet(returnPanel)
    } else {
      closeSheet()
    }
  }
  const refreshAccount = async () => {
    if (!signedIn) {
      return
    }
    try {
      const response = await fetch('/api/challenges', { signal })
      if (!response.ok) {
        throw new Error('Challenges unavailable')
      }
      const data: {
        challenges: UserChallengeProgress[]
        xp: number
        level: number
        xpProgress: number
        xpToNextLevel: number
        streak: number
      } = await response.json()
      setText('account-label', `LV ${data.level}`)
      setText('xp-label', `Level ${data.level} · ${data.xp} XP`)
      setText('xp-next', `${data.xpToNextLevel} to next level`)
      setText('streak', `${data.streak} days`)
      document.getElementById('xp-panel')!.classList.remove('hidden')
      document.querySelector<HTMLProgressElement>('#xp-fill')!.value =
        data.xpProgress
      const available = data.challenges.filter(
        c => !c.gameId || c.gameId === GameID.GAME_2048
      )
      setText(
        'commission-status',
        available.length
          ? 'Complete a dive to record your progress.'
          : 'No 2048 commissions today. Explore the catalogue for today’s challenges.'
      )
      const container = document.getElementById('commissions')!
      container.replaceChildren()
      available.forEach(challenge => {
        const fragment = document
          .querySelector<HTMLTemplateElement>('#commission-template')!
          .content.cloneNode(true) as DocumentFragment
        fragment.querySelector('[data-icon]')!.textContent = challenge.icon
        fragment.querySelector('[data-name]')!.textContent = challenge.name
        fragment.querySelector('[data-xp]')!.textContent =
          `+${challenge.xpReward} XP`
        fragment.querySelector('[data-description]')!.textContent =
          challenge.description
        fragment.querySelector('progress')!.value = Math.min(
          100,
          (challenge.currentValue / challenge.targetValue) * 100
        )
        fragment.querySelector('[data-progress]')!.textContent =
          challenge.completed
            ? 'Completed'
            : `${challenge.currentValue} / ${challenge.targetValue}`
        container.append(fragment)
      })
    } catch {
      if (!signal.aborted) {
        setText(
          'commission-status',
          'Commissions are unavailable. Open this panel again to retry.'
        )
      }
    }
  }
  const refreshLeaderboard = async () => {
    try {
      const response = await fetch('/api/leaderboard?gameId=2048&limit=5', {
        signal,
      })
      if (!response.ok) {
        throw new Error('Leaderboard unavailable')
      }
      const data: {
        leaderboard: Array<{ rank: number; name: string; score: number }>
      } = await response.json()
      const list = document.getElementById('leaderboard')!
      list.replaceChildren()
      data.leaderboard.forEach(entry => {
        const row = document.createElement('li')
        const name = document.createElement('span')
        name.textContent = `${entry.rank}. ${entry.name}`
        const score = document.createElement('span')
        score.className = 'mono'
        score.textContent = entry.score.toLocaleString()
        row.append(name, score)
        list.append(row)
      })
      setText(
        'leaderboard-status',
        data.leaderboard.length ? '' : 'No recorded dives yet.'
      )
    } catch {
      if (!signal.aborted) {
        setText(
          'leaderboard-status',
          'The leaderboard is unavailable. Open the field log again to retry.'
        )
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-sheet]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        returnPanel = currentPanel
        const state = handle?.getState()
        resumeAfterSheet = Boolean(state?.isActive && !state.isPaused)
        if (resumeAfterSheet) {
          handle?.game.pause()
        }
        showSheet(button.dataset.sheet!)
        if (currentPanel === 'log') {
          void refreshLeaderboard()
          void refreshAccount()
        }
        if (currentPanel === 'commission') {
          void refreshAccount()
        }
      },
      { signal }
    )
  )
  document
    .querySelectorAll('[data-close]')
    .forEach(button => button.addEventListener('click', closeInfo, { signal }))
  pauseButton.addEventListener('click', () => handle?.game.pause(), { signal })
  document
    .getElementById('resume-btn')!
    .addEventListener('click', () => handle?.game.resume(), { signal })
  const finish = () => {
    void handle?.endGame()
  }
  document
    .querySelectorAll('[data-end]')
    .forEach(button => button.addEventListener('click', finish, { signal }))
  document.getElementById('keep-playing-btn')!.addEventListener(
    'click',
    () => {
      if (handle?.getState().stuck) {
        if (handle.game.canUndo()) {
          showSheet('stuck')
        } else {
          finish()
        }
      } else {
        handle?.game.resume()
      }
    },
    { signal }
  )
  const undo = () => {
    if (handle?.undo()) {
      handle.renderer.getApp()?.canvas.focus({ preventScroll: true })
    }
  }
  undoButton.addEventListener('click', undo, { signal })
  document.getElementById('undo-stuck-btn')!.addEventListener(
    'click',
    () => {
      handle?.game.resume()
      undo()
    },
    { signal }
  )
  document.querySelectorAll<HTMLButtonElement>('[data-undos]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        const value = Number(button.dataset.undos)
        handle?.game.setUndos(value)
        document
          .querySelectorAll<HTMLButtonElement>('[data-undos]')
          .forEach(el =>
            el.setAttribute(
              'aria-pressed',
              String(Number(el.dataset.undos) === value)
            )
          )
      },
      { signal }
    )
  )
  const syncPreferences = () => {
    setText('sound-state', sound ? 'On' : 'Off')
    setText('motion-state', reducedMotion ? 'On' : 'Off')
    document
      .getElementById('sound-btn')!
      .setAttribute('aria-pressed', String(sound))
    document
      .getElementById('motion-btn')!
      .setAttribute('aria-pressed', String(reducedMotion))
    sheet.dataset.reducedMotion = String(reducedMotion)
    handle?.renderer.setReducedMotion(reducedMotion)
    if (handle && reducedMotion) {
      handle.renderer.render(handle.getState())
    }
  }
  document.getElementById('sound-btn')!.addEventListener(
    'click',
    () => {
      sound = !sound
      syncPreferences()
    },
    { signal }
  )
  document.getElementById('motion-btn')!.addEventListener(
    'click',
    () => {
      reducedMotion = !reducedMotion
      syncPreferences()
    },
    { signal }
  )
  document.addEventListener(
    'keydown',
    event => {
      if (panels.some(panel => panel.inert)) {
        return
      }
      if (event.key.toLowerCase() === 'p' && currentPanel === 'pause') {
        event.preventDefault()
        handle?.game.resume()
      }
    },
    { signal }
  )
  sheet.addEventListener(
    'cancel',
    event => {
      event.preventDefault()
      if (panels.some(panel => panel.inert)) {
        return
      }
      if (['help', 'log', 'commission'].includes(currentPanel)) {
        closeInfo()
      } else if (currentPanel === 'pause') {
        handle?.game.resume()
      }
    },
    { signal }
  )
  // A second Escape makes the browser's close watcher force-close the dialog
  // (non-cancelable), bypassing closeSheet — reopen the panel it stranded.
  sheet.addEventListener(
    'close',
    () => {
      if (currentPanel) {
        showSheet(currentPanel)
      }
    },
    { signal }
  )
  document.addEventListener(
    'visibilitychange',
    () => {
      if (
        document.hidden &&
        handle?.getState().isActive &&
        !handle.getState().isPaused
      ) {
        handle.game.pause()
      }
    },
    { signal }
  )
  const awards = document.getElementById('achievement-award-overlay')!
  const challenges = document.getElementById('challenge-complete-overlay')!
  const rewardObserver = new MutationObserver(() => {
    const active = !challenges.classList.contains('hidden')
      ? challenges
      : awards.style.display === 'flex'
        ? awards
        : null
    const wasBlocked = panels[0].inert
    if (active && !sheet.open) {
      handle?.game.pause()
    }
    panels.forEach(panel => (panel.inert = Boolean(active)))
    if (active) {
      active.querySelector<HTMLElement>('[data-card], button')?.focus()
    } else if (wasBlocked && sheet.open) {
      showSheet(currentPanel)
    }
  })
  rewardObserver.observe(awards, {
    attributes: true,
    attributeFilter: ['style'],
  })
  rewardObserver.observe(challenges, {
    attributes: true,
    attributeFilter: ['class'],
  })
  const blip = () => {
    if (!sound) {
      return
    }
    try {
      audio ??= new AudioContext()
      void audio.resume()
      const oscillator = audio.createOscillator(),
        gain = audio.createGain()
      oscillator.type = 'triangle'
      oscillator.frequency.value = 420
      gain.gain.setValueAtTime(0.035, audio.currentTime)
      gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.12)
      oscillator.connect(gain)
      gain.connect(audio.destination)
      oscillator.start()
      oscillator.stop(audio.currentTime + 0.12)
    } catch {
      /* Audio may be unavailable. */
    }
  }
  const tile = (
    context: CanvasRenderingContext2D,
    x: number,
    y: number,
    size: number,
    value: number
  ) => {
    context.beginPath()
    context.roundRect(x - size / 2, y - size / 2, size, size, size * 0.1)
    context.fillStyle = hex(getTileColor(value))
    if (value >= 2048) {
      context.shadowColor = context.fillStyle
      context.shadowBlur = 22
    }
    context.fill()
    context.shadowBlur = 0
    context.strokeStyle = 'rgba(234,246,255,.14)'
    context.stroke()
    context.fillStyle = hex(getTileTextColor(value))
    context.font = `500 ${Math.round(size * (value < 100 ? 0.46 : 0.3))}px "Field Display", serif`
    context.textAlign = 'center'
    context.textBaseline = 'middle'
    context.fillText(String(value), x, y + size * 0.03)
  }
  const paintFigures = () =>
    document
      .querySelectorAll<HTMLCanvasElement>('.rule-figure')
      .forEach(canvas => {
        const c = canvas.getContext('2d')!
        c.clearRect(0, 0, 300, 200)
        if (canvas.dataset.fig === 'goal') {
          tile(c, 150, 100, 112, 2048)
          return
        }
        for (const y of [52, 148]) {
          for (let col = 0; col < 4; col++) {
            c.beginPath()
            c.roundRect(42 + col * 56 - 24, y - 24, 48, 48, 5)
            c.fillStyle = '#0b1020'
            c.fill()
            c.strokeStyle = '#1a2a3a'
            c.stroke()
          }
        }
        tile(c, 98, 52, 48, 2)
        tile(c, 210, 52, 48, canvas.dataset.fig === 'slide' ? 8 : 2)
        tile(c, 42, 148, 48, canvas.dataset.fig === 'slide' ? 2 : 4)
        if (canvas.dataset.fig === 'slide') {
          tile(c, 98, 148, 48, 8)
        }
        c.fillStyle = '#22f5d0'
        c.font = '600 18px "Field Mono",monospace'
        c.textAlign = 'center'
        c.fillText('◂', 150, 100)
        if (canvas.dataset.fig === 'merge') {
          c.fillText('+4', 98, 148)
        }
      })
  showSheet('intro')
  syncBest()
  if (signedIn) {
    // getUserBestScore collapses failures and "no score yet" to a resolved
    // null (see scoreService), so there is no rejection path to handle; null
    // keeps the unknown-best rendering ("—", no personal-best badge).
    void getUserBestScore(GameID.GAME_2048).then(score => {
      savedBest = score
      syncBest()
    })
  }
  const initialize = async () => {
    try {
      await document.fonts.load('500 40px "Field Display"')
      paintFigures()
      handle = await init2048GameFramework(
        {
          tileSize: 142.5,
          gap: 14,
          gameWidth: 640,
          gameHeight: 640,
          animationDuration: 110,
        },
        {
          onStart: () => {
            closeSheet()
            previousScore = 0
            previousMax = 0
            previousWon = false
            previousUndosUsed = 0
            pauseButton.disabled = false
            document.getElementById('merge-feedback')!.textContent = ''
            setText(
              'game-status',
              'Dive started. Use arrow keys or swipe to slide.'
            )
          },
          onPause: () => showSheet('pause'),
          onResume: closeSheet,
          onStateChange: state => {
            const s = state as Game2048State
            const next = [64, 128, 256, 512, 1024, 2048, 4096].find(
              value => value > s.maxTile
            )
            setText('next-target', next ? `Next · ${next}` : 'Beyond the chart')
            document
              .querySelectorAll<HTMLElement>('[data-milestone]')
              .forEach(el => {
                const value = Number(el.dataset.milestone),
                  reached = s.maxTile >= value
                el.style.background = reached
                  ? hex(getTileColor(value))
                  : 'transparent'
                el.style.borderColor = reached
                  ? hex(getTileColor(value))
                  : value === next
                    ? '#22f5d0'
                    : '#26333d'
                el.setAttribute(
                  'aria-label',
                  `${value}${reached ? ', reached' : ''}`
                )
              })
            const free = s.board.flat().filter(value => !value).length
            const directions = handle?.game.legalDirections() ?? []
            const arrow = { left: '◂', right: '▸', up: '▴', down: '▾' }
            setText(
              'board-warning',
              !s.isActive
                ? ''
                : directions.length === 1
                  ? `One way out ${arrow[directions[0]]}`
                  : free <= 2
                    ? `${free} cell${free === 1 ? '' : 's'} free`
                    : ''
            )
            document
              .getElementById('board-warning')!
              .classList.toggle('urgent', directions.length === 1)
            setText('undos-left', s.undosLeft)
            undoButton.disabled = !handle?.game.canUndo() || s.isPaused
            undoButton.style.visibility =
              s.undosLeft + s.undosUsed > 0 ? 'visible' : 'hidden'
            const gain = s.score - previousScore
            if (gain > 0) {
              const feedback = document.getElementById('merge-feedback')!
              feedback.textContent = `+${gain}`
              feedback.getAnimations().forEach(animation => animation.cancel())
              feedback.animate(
                reducedMotion
                  ? [{ opacity: 1 }, { opacity: 1 }]
                  : [
                      { opacity: 1, transform: 'translate(-50%,0)' },
                      { opacity: 0, transform: 'translate(-50%,-50px)' },
                    ],
                { duration: 900 }
              )
              blip()
            }
            if (s.maxTile >= 64 && s.maxTile > previousMax) {
              setText(
                'game-status',
                `New highest tile: ${s.maxTile}. Score ${s.score}.`
              )
            }
            if (s.undosUsed > previousUndosUsed) {
              setText(
                'game-status',
                `Move undone. ${s.undosLeft} undo${s.undosLeft === 1 ? '' : 's'} left.`
              )
            }
            previousUndosUsed = s.undosUsed
            previousScore = s.score
            previousMax = s.maxTile
            document
              .querySelectorAll('[data-best]')
              .forEach(
                el =>
                  (el.textContent =
                    savedBest === null
                      ? '—'
                      : String(Math.max(savedBest, visitBest, s.score)))
              )
            if (s.won && !previousWon && s.isActive) {
              handle?.game.pause()
              setText(
                'win-line',
                `${s.score} points · ${s.moveCount} move${s.moveCount === 1 ? '' : 's'}`
              )
              showSheet('win')
            } else if (s.stuck && handle?.game.canUndo() && s.isActive) {
              handle.game.pause()
              showSheet('stuck')
            }
            previousWon = s.won
          },
          onEnd: (score, stats) => {
            const s = stats as Game2048Stats
            pauseButton.disabled = true
            undoButton.disabled = true
            lastResult = { score, previousBest: visitBest }
            visitBest = Math.max(visitBest, score)
            syncBest()
            setText('final-merges', s.mergeCount)
            setText(
              'points-per-move',
              s.moveCount ? Math.round(score / s.moveCount) : '—'
            )
            setText('final-undos', s.undosUsed)
            document
              .getElementById('final-undos')!
              .classList.toggle('amber', s.undosUsed > 0)
            const finalTile = document.getElementById('final-max-tile')!
            finalTile.style.background = hex(getTileColor(s.maxTile))
            finalTile.style.color = hex(getTileTextColor(s.maxTile))
            finalTile.style.fontSize =
              s.maxTile < 100 ? '32px' : s.maxTile < 1000 ? '27px' : '21px'
            setText(
              'results-title',
              s.maxTile >= 2048
                ? 'A specimen of record'
                : s.maxTile >= 512
                  ? 'Deep, not deep enough'
                  : 'The bed set early'
            )
            setText(
              'result-advice',
              s.maxTile >= 2048
                ? 'A specimen of record. Past 2048 the board gets tight fast — keep the largest tile pinned in one corner and never slide away from it.'
                : s.maxTile >= 512
                  ? 'Close. Runs usually break when the big tile leaves its corner. Favour two directions and only use the third when forced.'
                  : 'Pick a corner and keep your largest tile there. Sliding toward it every move builds a descending chain instead of scattered pairs.'
            )
            visits++
            visitTile = Math.max(visitTile, s.maxTile)
            setText('visit-count', visits)
            setText('visit-tile', visitTile)
            document.getElementById('empty-log')!.classList.add('hidden')
            const row = document.createElement('li'),
              detail = document.createElement('span'),
              points = document.createElement('span')
            detail.textContent = `Tile ${s.maxTile} · ${s.moveCount} move${s.moveCount === 1 ? '' : 's'}${s.undosUsed ? ` · ${s.undosUsed} undo${s.undosUsed === 1 ? '' : 's'}` : ''}`
            points.textContent = String(score)
            points.className = 'mono'
            row.append(detail, points)
            document.getElementById('recent-dives')!.prepend(row)
            setText(
              'game-status',
              `Dive over. Score ${score}, highest tile ${s.maxTile}.`
            )
            showSheet('results')
          },
        }
      )
      if (!handle) {
        throw new Error('Renderer unavailable')
      }
      // onEnd fires before the score save resolves, so account state (XP,
      // challenge labels) refreshes off the post-save structured end event.
      // The event.data guard skips bare end events forwarded from the timer.
      handle.game.on('end', event => {
        if (event.data) {
          void refreshAccount()
        }
      })
      ;(window as Window & { game2048?: Game2048InitResult }).game2048 = handle
      syncPreferences()
      startButton.disabled = false
      setText('load-status', '')
    } catch (error) {
      setText(
        'load-status',
        'The plate could not start. Reload the page to try again.'
      )
      console.error(error)
    }
  }
  void initialize()
  window.addEventListener(
    'pagehide',
    event => {
      if (event.persisted) {
        handle?.game.pause()
        return
      }
      controller.abort()
      rewardObserver.disconnect()
      handle?.cleanup()
      void audio?.close()
    },
    { signal }
  )
</script>
