---
import GamePage from '@/components/games/GamePage.astro'
import Badge from '@/components/ui/Badge.astro'
import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import { ASTEROID_DRIFT_RULES } from '@/lib/games/asteroid-drift/types'
---

<GamePage
  gameId="asteroid-drift"
  title="Asteroid Drift"
  description="Thrust a momentum-bound ship through 90 seconds of rising asteroid traffic and grab energy orbs for bonus score."
  icon="☄️"
  initialTime={ASTEROID_DRIFT_RULES.duration}
  showPause={false}
  showEnd={false}
  showReset={true}
  overlayTitle="SHIP LOST"
>
  <div
    slot="game-board"
    id="asteroid-drift-container"
    class="w-full max-w-[800px]"
  >
    <div
      id="asteroid-drift-canvas"
      class="overflow-hidden rounded-lg bg-black/30"
    >
    </div>
    <p id="asteroid-drift-status" class="sr-only" aria-live="polite"></p>
  </div>

  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Orbs: <span id="orbs-collected">0</span></span>
  </Badge>
  <Badge slot="additional-stats" variant="outline" class="px-4 py-2">
    <span class="font-mono">Speed: <span id="ship-speed">0</span></span>
  </Badge>

  <div slot="controls">
    <Card variant="glass" class="p-6">
      <div class="flex flex-col items-center space-y-4">
        <div class="flex flex-wrap justify-center gap-2">
          <Button id="start-btn" type="button" variant="primary">
            Start Game
          </Button>
          <Button id="reset-btn" type="button" variant="outline">
            Reset
          </Button>
        </div>
        <div
          id="asteroid-drift-dpad"
          class="grid grid-cols-3 gap-2 select-none"
          style="grid-template-areas: '. up .' 'left . right' '. down .';"
        >
          <button
            type="button"
            data-direction="up"
            aria-label="Thrust up"
            class="dpad-btn"
            tabindex="-1"
            style="grid-area: up;"
          >
            &#8593;
          </button>
          <button
            type="button"
            data-direction="left"
            aria-label="Thrust left"
            class="dpad-btn"
            tabindex="-1"
            style="grid-area: left;"
          >
            &#8592;
          </button>
          <button
            type="button"
            data-direction="right"
            aria-label="Thrust right"
            class="dpad-btn"
            tabindex="-1"
            style="grid-area: right;"
          >
            &#8594;
          </button>
          <button
            type="button"
            data-direction="down"
            aria-label="Thrust down"
            class="dpad-btn"
            tabindex="-1"
            style="grid-area: down;"
          >
            &#8595;
          </button>
        </div>
      </div>
    </Card>
  </div>

  <div slot="game-info" class="space-y-6">
    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ HOW TO PLAY
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <p>Hold arrows or WASD to thrust — the ship drifts with momentum.</p>
        <p>Asteroids pour in from every edge as the run ramps up.</p>
        <p>Grab energy orbs before they fade for bonus score.</p>
        <p>Survive the full {ASTEROID_DRIFT_RULES.duration} seconds to win.</p>
      </div>
    </Card>

    <Card variant="glass" class="p-6">
      <h3 class="font-mono text-sm tracking-wide text-cetus-accent mb-4">
        ▸ SCORING
      </h3>
      <div class="space-y-2 text-sm text-cetus-ink">
        <p>
          Survival earns {ASTEROID_DRIFT_RULES.survivalPointsPerSecond} points per
          second.
        </p>
        <p>Each energy orb adds {ASTEROID_DRIFT_RULES.orbPoints} points.</p>
        <p>An asteroid collision ends the run immediately.</p>
      </div>
    </Card>
  </div>

  <div slot="final-stats">
    <div class="text-lg text-cetus-ink">
      Outcome: <span id="final-outcome" class="text-cetus-accent">—</span>
    </div>
    <div class="text-lg text-cetus-ink">
      Survival:
      <span id="final-survival" class="text-cetus-accent-2">0</span>s
    </div>
    <div class="text-lg text-cetus-ink">
      Orbs: <span id="final-orbs" class="text-cetus-accent-3">0</span>
    </div>
  </div>
</GamePage>

<script>
  import { initAsteroidDriftGameFramework } from '@/lib/games/asteroid-drift/initFramework'

  document.addEventListener('DOMContentLoaded', () => {
    initAsteroidDriftGameFramework()
      .then(handle => {
        if (handle) {
          ;(
            window as Window & { asteroidDriftGame?: typeof handle }
          ).asteroidDriftGame = handle
        }
      })
      .catch(error => {
        console.error('Asteroid Drift failed to initialize', error)
      })
  })
</script>

<style>
  #asteroid-drift-canvas :global(canvas) {
    display: block;
    max-width: 100%;
    height: auto;
    touch-action: manipulation;
  }

  /* Hide the touch D-pad on devices with a fine pointer (desktop/mouse). */
  @media (hover: hover) and (pointer: fine) {
    #asteroid-drift-dpad {
      display: none;
    }
  }

  .dpad-btn {
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    border-radius: 0.75rem;
    border: 2px solid color-mix(in oklab, var(--cetus-accent) 50%, transparent);
    background: color-mix(in oklab, var(--cetus-accent) 8%, transparent);
    color: var(--cetus-accent);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition:
      background 0.1s,
      border-color 0.1s,
      box-shadow 0.1s;
  }

  .dpad-btn:focus-visible {
    outline: 2px solid var(--cetus-accent);
    outline-offset: 2px;
    box-shadow: 0 0 12px
      color-mix(in oklab, var(--cetus-accent) 45%, transparent);
  }

  .dpad-btn:active,
  .dpad-btn.active {
    background: color-mix(in oklab, var(--cetus-accent) 35%, transparent);
    border-color: var(--cetus-accent);
    box-shadow: 0 0 18px
      color-mix(in oklab, var(--cetus-accent) 55%, transparent);
  }
</style>
