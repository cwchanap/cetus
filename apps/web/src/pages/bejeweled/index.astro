---
import AppLayout from '@/layouts/AppLayout.astro'
import AppNotifications from '@/components/islands/AppNotifications'
import BejeweledScreen from '@/components/islands/games/BejeweledScreen'
const user = Astro.locals.user
const instructions = [
  {
    image: 'swap',
    alt: 'A gem swapping down to complete a line of three',
    label: 'Swap into three',
  },
  {
    image: 'cascade',
    alt: 'A ladder of three gems growing with each link of the chain',
    label: 'Chains multiply · ×2 ×3',
  },
  { image: 'timer', alt: 'A sixty-second dial', label: 'Sixty seconds' },
]
const neighbours = [
  { href: '/tetris', number: 'I', name: 'Tetris Challenge', color: '#22f5d0' },
  {
    href: '/bubble-shooter',
    number: 'II',
    name: 'Bubble Shooter',
    color: '#6fe3ff',
  },
  {
    href: '/memory-matrix',
    number: 'IV',
    name: 'Memory Matrix',
    color: '#ffc24a',
  },
]
---

<AppLayout
  title="Bejeweled — Cetus"
  description="Swap into three. Let the chains multiply. Sixty seconds in the shallows."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>
  <BejeweledScreen client:load signedIn={Boolean(user)} />
  <Fragment slot="notifications">
    <dialog id="field-sheet" aria-labelledby="intro-title">
      <section id="intro-panel" data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. III · Specimen notes</span><span
            class="micro">Cluster · Six pigments</span
          >
        </div>
        <h2 id="intro-title">Bejeweled</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <img
                    src={`/images/bejeweled/${item.image}.png`}
                    alt={item.alt}
                    width="150"
                    height="100"
                  />
                  <figcaption class:list={['micro', { amber: i === 1 }]}>
                    <span class:list={['accent', { amber: i === 1 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="record-line">
          <span class="micro">{user ? 'Your best' : 'Best this visit'}</span
          ><span class="mono" data-best>—</span>
        </div>
        <p id="game-error" class="error-message hidden" role="alert">
          The plate could not be loaded. Refresh to try again.
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Loading the plate…</button
        >
        <div class="action-pair">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section id="pause-panel" data-panel="pause" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Pace</p>
        <div class="action-pair" role="group" aria-label="Animation pace">
          <button class="secondary-action" data-pace="swift" aria-pressed="true"
            >Swift</button
          ><button
            class="secondary-action"
            data-pace="measured"
            aria-pressed="false">Measured</button
          >
        </div>
        <p class="setting-note">
          Swift keeps swaps and cascades brief. Both paces give you sixty
          seconds.
        </p>
        <div class="settings">
          <button id="glyphs-btn" aria-pressed="false"
            ><span>Pigment glyphs</span><span class="micro" data-state>Off</span
            ></button
          >
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span class="micro" data-state>On</span></button
          >
          <button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span class="micro" data-state>Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button>
        <button id="reset-btn" class="secondary-action"
          >Abandon &amp; restart</button
        >
        <button id="end-btn" class="exit-action micro" style="display:none"
          >End dive</button
        >
        <p class="micro controls-hint">
          P resume · Arrows move · Enter select · H hint
        </p>
      </section>
      <section id="game-over-overlay" data-panel="results" class="hidden">
        <div class="sheet-kicker">
          <span class="micro">Dive record · Pl. III</span><span
            id="personal-best"
            class="micro new-best hidden">Personal best</span
          >
        </div>
        <h2 id="results-title">The tide turns</h2>
        <div class="result-score">
          <div>
            <span class="micro">Score</span><div
              id="final-score"
              class="large-stat"
            >
              0
            </div>
          </div><div>
            <span class="micro">Per move</span><div
              id="per-move"
              class="stat-value ice"
            >
              —
            </div>
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Moves made</dt><dd id="final-moves">0</dd></div><div>
            <dt>Best chain</dt><dd id="final-combo" class="amber">×0</dd>
          </div><div>
            <dt>Largest match</dt><dd id="final-largest">0</dd>
          </div><div><dt>Matches cleared</dt><dd id="final-matches">0</dd></div>
        </dl>
        <div class="field-note">
          <span class="micro">Field note</span><p>
            Work near the roots of a cluster. Falling gems can turn one match
            into a chain.
          </p>
        </div>
        <p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={{ background: item.color }} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="play-again-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div>
        <h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <img
                    src={`/images/bejeweled/${item.image}.png`}
                    alt={item.alt}
                    width="150"
                    height="100"
                  />
                  <figcaption class:list={['micro', { amber: i === 1 }]}>
                    <span class:list={['accent', { amber: i === 1 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>A swap holds</dt><dd>Only if it makes 3+</dd></div><div>
            <dt>Each chain link</dt><dd class="amber">Raises the multiplier</dd>
          </div><div><dt>✦ Hint</dt><dd>Marks one legal swap</dd></div>
        </dl>
        <p class="micro controls-hint">
          Arrows move · Enter select · H hint · P pause
        </p><button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Chain this visit</span><strong
              class="amber"
              id="visit-chain">×0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user ? 'Saved scores & achievements ↗' : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In the shallows</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AppNotifications client:load />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>
<style is:global>
  /* The plate body moved into the BejeweledScreen island (HPA-393);
     Astro-scoped selectors never match island-rendered elements, so
     the whole block is global (batch 1-3 precedent). Bare element
     selectors are scoped under their containers with :where() — the
     zero-specificity wrapper keeps the cascade (0,0,1)-equivalent
     for every plate node. Sheet coverage lists include both
     `.field-sheet` and `#field-sheet` (this route's dialog is
     id-only), and the sheet button legs exclude the notifications
     astro-island subtree via :where(:not(astro-island *)) so island
     chrome (#challenge-continue) keeps its own styles while static
     sheet buttons stay covered. */
  @font-face {
    font-family: 'Field Newsreader';
    src: url('/fonts/field-plate/newsreader.woff2') format('woff2');
    font-weight: 300 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Sans';
    src: url('/fonts/field-plate/plex-sans.woff2') format('woff2');
    font-weight: 400 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'Field Mono';
    src: url('/fonts/field-plate/plex-mono.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  body[data-field-plate] {
    background: #04060a;
    color: #eaf6ff;
    font-family: 'Field Sans', sans-serif;
  }
  body[data-field-plate]::after {
    background-image: radial-gradient(
      rgba(234, 246, 255, 0.055) 0.5px,
      transparent 0.5px
    );
    background-size: 4px 4px;
    opacity: 0.5;
  }
  .plate-width {
    width: min(100%, 1000px);
    margin: 0 auto;
    padding-inline: 24px;
  }
  .plate-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-block: 22px 17px;
    position: relative;
  }
  .plate-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 24px;
    right: 24px;
    height: 4px;
    border-top: 1px solid #2e3e49;
    border-bottom: 1px solid #26333d;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    font:
      400 23px/1 'Field Newsreader',
      serif;
  }
  .brand-orb {
    width: 28px;
    height: 28px;
    border: 1px solid #2e3e49;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .brand-orb::after {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22f5d0;
  }
  :where(.plate-width) nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a {
    color: inherit;
    text-decoration: none;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:hover {
    color: #22f5d0;
  }
  .micro,
  .mono,
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    font-family: 'Field Mono', monospace;
  }
  .micro {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a98a6;
  }
  .mono {
    font-size: 13px;
  }
  .accent {
    color: #22f5d0;
  }
  .amber {
    color: #ffc24a;
  }
  .ice {
    color: #6fe3ff;
  }
  .urgent {
    color: #ff3d8a;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)),
  .account {
    border: 1px solid #26333d;
    border-radius: 2px;
    background: #0a1219;
    color: #a7b4bd;
  }
  :where(.plate-width) button,
  :where(.field-sheet, #field-sheet) button:where(:not(astro-island *)) {
    cursor: pointer;
  }
  :where(.plate-width) button:disabled,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):disabled {
    opacity: 0.45;
    cursor: default;
  }
  :where(.plate-width) button:hover:not(:disabled),
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):hover:not(:disabled) {
    border-color: #22f5d0;
    color: #eaf6ff;
  }
  :where(.plate-width, .field-sheet, #field-sheet) a:focus-visible,
  :where(.plate-width) button:focus-visible,
  :where(.field-sheet, #field-sheet)
    button:where(:not(astro-island *)):focus-visible,
  #bejeweled-container canvas:focus-visible {
    outline: 2px solid #22f5d0;
    outline-offset: 3px;
  }
  .account {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 11px 4px 4px;
  }
  .account > span:first-child {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #22f5d0;
    color: #04060a;
    letter-spacing: 0;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-block: 16px 14px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.28em;
  }
  :where(.plate-width) h1,
  :where(.field-sheet, #field-sheet) h2 {
    font-family: 'Field Newsreader', serif;
    font-weight: 400;
    line-height: 1.05;
  }
  :where(.plate-width) h1 {
    font-size: clamp(28px, 4vw, 38px);
    margin-top: 6px;
  }
  :where(.field-sheet, #field-sheet) h2 {
    font-size: 36px;
    font-weight: 300;
    margin-top: 12px;
  }
  :where(.field-sheet, #field-sheet) h2:focus {
    outline: none;
  }
  #pause-title,
  #log-title,
  #commission-title {
    font-size: 28px;
  }
  #results-title {
    font-size: 32px;
  }
  .tools {
    display: flex;
    gap: 6px;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    font-size: 14px;
  }
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 18px 34px;
    padding-block: 14px;
    border-block: 1px solid #26333d;
  }
  .score-stat {
    min-width: 120px;
  }
  .time-stat {
    min-width: 104px;
  }
  .large-stat {
    font:
      400 clamp(38px, 6.5vw, 52px) / 1 'Field Newsreader',
      serif;
    letter-spacing: -0.01em;
  }
  :where(.plate-width, .field-sheet, #field-sheet) progress {
    display: block;
    width: 100%;
    height: 7px;
    border: 1px solid #26333d;
    background: #0a1219;
    color: #22f5d0;
    appearance: none;
  }
  :where(.plate-width, .field-sheet, #field-sheet)
    progress::-webkit-progress-bar {
    background: #0a1219;
  }
  :where(.plate-width, .field-sheet, #field-sheet)
    progress::-webkit-progress-value {
    background: currentColor;
  }
  :where(.plate-width, .field-sheet, #field-sheet) progress::-moz-progress-bar {
    background: currentColor;
  }
  #time-fill {
    height: 4px;
    margin-top: 6px;
  }
  .small-stats {
    display: flex;
    gap: 22px;
    padding-bottom: 6px;
  }
  .stat-value {
    font:
      15px 'Field Mono',
      monospace;
    margin-top: 4px;
  }
  .cascade {
    flex: 1 1 200px;
    min-width: 180px;
    padding-bottom: 4px;
  }
  .cascade-label {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  #cascade-pips {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }
  #cascade-pips span {
    height: 8px;
    flex: 1;
    border: 1px solid #26333d;
    background: transparent;
  }
  #cascade-pips span.active {
    background: #22f5d0;
  }
  #cascade-pips span.active:nth-child(n + 3) {
    background: #ffc24a;
  }
  .chain-note {
    margin-top: 7px;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  .play-area {
    width: min(100%, 472px);
    margin: 18px auto 0;
    padding-bottom: 40px;
  }
  .plate-frame {
    position: relative;
    padding: 10px;
    border: 1px solid #2e3e49;
    background: #0a1219;
  }
  .corner {
    position: absolute;
    width: 9px;
    height: 9px;
    border-color: #22f5d0;
    border-style: solid;
    border-width: 0;
  }
  .top-left {
    top: 4px;
    left: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .top-right {
    top: 4px;
    right: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .bottom-left {
    bottom: 4px;
    left: 4px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .bottom-right {
    bottom: 4px;
    right: 4px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  #bejeweled-container {
    width: 100%;
    aspect-ratio: 1;
    background: #070b16;
  }
  #bejeweled-container canvas {
    display: block;
    width: 100% !important;
    height: auto !important;
    cursor: pointer;
  }
  .board-tray {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    padding: 9px 12px;
    border: 1px solid #26333d;
    background: #0a1219;
  }
  #board-notice {
    flex: 1;
    min-width: 0;
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .tray-action {
    min-height: 44px;
    padding: 0 14px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .controls-hint {
    margin-top: 8px;
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  #field-sheet {
    margin: auto;
    width: min(430px, calc(100% - 40px));
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    padding: 26px;
    border: 1px solid #2e3e49;
    background: #0a1219;
    color: #eaf6ff;
    font-family: 'Field Sans', sans-serif;
  }
  #field-sheet::backdrop {
    background: rgba(2, 4, 8, 0.9);
  }
  #field-sheet[data-panel='log'] {
    width: min(490px, calc(100% - 40px));
  }
  #field-sheet[data-panel='results'] {
    width: min(470px, calc(100% - 40px));
  }
  #field-sheet[data-panel='commission'] {
    border-color: #ffc24a;
  }
  #field-sheet .hidden {
    display: none;
  }
  .sheet-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sheet-kicker .micro {
    font-size: 9px;
    letter-spacing: 0.16em;
  }
  .instructions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #1c2730;
  }
  .instructions figure {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0;
  }
  .instructions img {
    flex: 0 0 auto;
    width: 150px;
    height: 100px;
    object-fit: contain;
    border: 1px solid #1c2730;
    background: #04060a;
  }
  .instructions figcaption {
    display: flex;
