---
import AppLayout from '@/layouts/AppLayout.astro'
import AchievementAward from '@/components/AchievementAward.astro'
import ChallengeComplete from '@/components/ChallengeComplete.astro'
const user = Astro.locals.user
const instructions = [
  {
    image: 'swap',
    alt: 'A gem swapping down to complete a line of three',
    label: 'Swap into three',
  },
  {
    image: 'cascade',
    alt: 'A ladder of three gems growing with each link of the chain',
    label: 'Chains multiply · ×2 ×3',
  },
  { image: 'timer', alt: 'A sixty-second dial', label: 'Sixty seconds' },
]
const neighbours = [
  { href: '/tetris', number: 'I', name: 'Tetris Challenge', color: '#22f5d0' },
  {
    href: '/bubble-shooter',
    number: 'II',
    name: 'Bubble Shooter',
    color: '#6fe3ff',
  },
  {
    href: '/memory-matrix',
    number: 'IV',
    name: 'Memory Matrix',
    color: '#ffc24a',
  },
]
---

<AppLayout
  title="Bejeweled — Cetus"
  description="Swap into three. Let the chains multiply. Sixty seconds in the shallows."
  includeFooter={false}
  data-field-plate
>
  <header slot="header" class="plate-header plate-width">
    <a class="wordmark" href="/" aria-label="Cetus home"
      ><span class="brand-orb" aria-hidden="true"></span>Cetus</a
    >
    <nav aria-label="Primary">
      <a href="/#games" class="micro">← Catalogue</a>
      <a href={user ? '/profile' : '/login'} class="account micro"
        ><span aria-hidden="true"
          >{user ? user.name.slice(0, 2).toUpperCase() : '↗'}</span
        ><span id="account-label">{user ? 'Your log' : 'Sign in'}</span></a
      >
    </nav>
  </header>
  <div class="plate-width field-plate" data-signed-in={Boolean(user)}>
    <div class="title-row">
      <div>
        <p class="micro accent eyebrow">Pl. III — Shallow · 0–200 m</p><h1>
          Bejeweled
        </h1>
      </div>
      <div class="tools">
        <button
          class="icon-button"
          data-sheet="commission"
          aria-label="Today's commission"
          title="Today's commission">💎</button
        >
        <button
          class="icon-button"
          data-sheet="help"
          aria-label="How it plays"
          title="How it plays">?</button
        >
        <button
          class="icon-button"
          data-sheet="log"
          aria-label="Field log"
          title="Field log">▤</button
        >
        <button
          class="icon-button"
          id="pause-btn"
          aria-label="Pause"
          title="Pause (P)"
          disabled>Ⅱ</button
        >
      </div>
    </div>
    <div class="hud" aria-label="Dive statistics">
      <div class="score-stat">
        <div class="micro">Score</div><div id="score" class="large-stat">0</div>
      </div>
      <div class="time-stat">
        <div class="micro">Time left</div><div
          id="time-remaining"
          class="large-stat accent"
        >
          60
        </div><progress
          id="time-fill"
          max="60"
          value="60"
          aria-label="Time remaining"></progress>
      </div>
      <div class="small-stats">
        <div>
          <div class="micro">Best</div><div class="stat-value" data-best>—</div>
        </div>
        <div>
          <div class="micro">Moves</div><div class="stat-value" id="moves">
            0
          </div>
        </div>
      </div>
      <div class="cascade">
        <div class="cascade-label micro">
          <span>Cascade</span><span id="cascade-label">Idle</span>
        </div>
        <div id="cascade-pips" aria-hidden="true">
          {Array.from({ length: 5 }, () => <span />)}
        </div>
        <div class="micro chain-note">
          Best chain this run · <span id="max-combo" class="amber">×0</span>
        </div>
      </div>
    </div>
    <div class="play-area">
      <div class="plate-frame">
        <span class="corner top-left" aria-hidden="true"></span><span
          class="corner top-right"
          aria-hidden="true"></span><span
          class="corner bottom-left"
          aria-hidden="true"></span><span
          class="corner bottom-right"
          aria-hidden="true"></span>
        <div id="bejeweled-container" aria-label="Bejeweled playfield"></div>
      </div>
      <div class="board-tray">
        <p class="micro" id="board-notice" role="status">
          Drag a gem onto its neighbour
        </p><button
          id="hint-btn"
          class="tray-action"
          title="Show a legal swap (H)"
          disabled>✦ Hint</button
        >
      </div>
      <p class="micro controls-hint">
        Tap to select · Drag to swap · Arrows + Enter
      </p>
    </div>
  </div>
  <Fragment slot="notifications">
    <dialog id="field-sheet" aria-labelledby="intro-title">
      <section id="intro-panel" data-panel="intro">
        <div class="sheet-kicker">
          <span class="micro accent">Pl. III · Specimen notes</span><span
            class="micro">Cluster · Six pigments</span
          >
        </div>
        <h2 id="intro-title">Bejeweled</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <img
                    src={`/images/bejeweled/${item.image}.png`}
                    alt={item.alt}
                    width="150"
                    height="100"
                  />
                  <figcaption class:list={['micro', { amber: i === 1 }]}>
                    <span class:list={['accent', { amber: i === 1 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <div class="record-line">
          <span class="micro">{user ? 'Your best' : 'Best this visit'}</span
          ><span class="mono" data-best>—</span>
        </div>
        <p id="game-error" class="error-message hidden" role="alert">
          The plate could not be loaded. Refresh to try again.
        </p>
        <button id="start-btn" class="primary-action" disabled
          >Loading the plate…</button
        >
        <div class="action-pair">
          <button class="secondary-action" data-sheet="log">Field log</button
          ><button class="secondary-action" data-sheet="help">? Method</button>
        </div>
      </section>
      <section id="pause-panel" data-panel="pause" class="hidden">
        <p class="micro accent">Dive held</p><h2 id="pause-title">Paused</h2>
        <p class="micro settings-label">Pace</p>
        <div class="action-pair" role="group" aria-label="Animation pace">
          <button class="secondary-action" data-pace="swift" aria-pressed="true"
            >Swift</button
          ><button
            class="secondary-action"
            data-pace="measured"
            aria-pressed="false">Measured</button
          >
        </div>
        <p class="setting-note">
          Swift keeps swaps and cascades brief. Both paces give you sixty
          seconds.
        </p>
        <div class="settings">
          <button id="glyphs-btn" aria-pressed="false"
            ><span>Pigment glyphs</span><span class="micro" data-state>Off</span
            ></button
          >
          <button id="sound-btn" aria-pressed="true"
            ><span>Sound</span><span class="micro" data-state>On</span></button
          >
          <button id="motion-btn" aria-pressed="false"
            ><span>Reduced motion</span><span class="micro" data-state>Off</span
            ></button
          >
        </div>
        <button id="resume-btn" class="primary-action">Continue</button>
        <button id="reset-btn" class="secondary-action"
          >Abandon &amp; restart</button
        >
        <button id="end-btn" class="exit-action micro" style="display:none"
          >End dive</button
        >
        <p class="micro controls-hint">
          P resume · Arrows move · Enter select · H hint
        </p>
      </section>
      <section id="game-over-overlay" data-panel="results" class="hidden">
        <div class="sheet-kicker">
          <span class="micro">Dive record · Pl. III</span><span
            id="personal-best"
            class="micro new-best hidden">Personal best</span
          >
        </div>
        <h2 id="results-title">The tide turns</h2>
        <div class="result-score">
          <div>
            <span class="micro">Score</span><div
              id="final-score"
              class="large-stat"
            >
              0
            </div>
          </div><div>
            <span class="micro">Per move</span><div
              id="per-move"
              class="stat-value ice"
            >
              —
            </div>
          </div>
        </div>
        <dl class="result-rows">
          <div><dt>Moves made</dt><dd id="final-moves">0</dd></div><div>
            <dt>Best chain</dt><dd id="final-combo" class="amber">×0</dd>
          </div><div>
            <dt>Largest match</dt><dd id="final-largest">0</dd>
          </div><div><dt>Matches cleared</dt><dd id="final-matches">0</dd></div>
        </dl>
        <div class="field-note">
          <span class="micro">Field note</span><p>
            Work near the roots of a cluster. Falling gems can turn one match
            into a chain.
          </p>
        </div>
        <p class="micro settings-label">Neighbouring plates</p>
        <div class="neighbours">
          {
            neighbours.map(item => (
              <a href={item.href}>
                <span class="neighbour-art" aria-hidden="true">
                  <span style={{ background: item.color }} />
                </span>
                <span class="micro accent">Pl. {item.number}</span>
                {item.name}
              </a>
            ))
          }
        </div>
        <button id="play-again-btn" class="primary-action">Dive again</button
        ><button class="secondary-action" data-sheet="log">Field log</button>
      </section>
      <section data-panel="help" class="hidden">
        <div class="sheet-kicker">
          <span class="micro accent">Method</span><button
            class="close-button"
            data-close
            aria-label="Close help">Close ×</button
          >
        </div>
        <h2 id="help-title" class="sr-only">How it plays</h2>
        <div class="instructions">
          {
            instructions.map((item, i) => (
              <figure>
                <>
                  <img
                    src={`/images/bejeweled/${item.image}.png`}
                    alt={item.alt}
                    width="150"
                    height="100"
                  />
                  <figcaption class:list={['micro', { amber: i === 1 }]}>
                    <span class:list={['accent', { amber: i === 1 }]}>
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {item.label}
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
        <dl class="result-rows method-rows">
          <div><dt>A swap holds</dt><dd>Only if it makes 3+</dd></div><div>
            <dt>Each chain link</dt><dd class="amber">Raises the multiplier</dd>
          </div><div><dt>✦ Hint</dt><dd>Marks one legal swap</dd></div>
        </dl>
        <p class="micro controls-hint">
          Arrows move · Enter select · H hint · P pause
        </p><button class="primary-action" data-close>Got it</button>
      </section>
      <section data-panel="log" class="hidden">
        <div class="sheet-kicker">
          <div>
            <p class="micro accent">Field log</p><h2 id="log-title">
              Your dive record
            </h2>
          </div><button
            class="close-button"
            data-close
            aria-label="Close field log">Close ×</button
          >
        </div>
        <div id="xp-panel" class="record-box hidden">
          <div class="micro">
            <span id="xp-label"></span><span id="xp-next"></span>
          </div><progress
            id="xp-fill"
            max="100"
            value="0"
            aria-label="Level progress"></progress><div class="record-line">
            <span class="micro">Challenge streak</span><span
              class="mono amber"
              id="streak"></span>
          </div>
        </div>
        <div class="log-stats">
          <div>
            <span class="micro">Best</span><strong data-best>—</strong>
          </div><div>
            <span class="micro">Dives this visit</span><strong id="visit-count"
              >0</strong
            >
          </div><div>
            <span class="micro">Chain this visit</span><strong
              class="amber"
              id="visit-chain">×0</strong
            >
          </div>
        </div>
        <p class="micro settings-label">Dives this visit</p><p
          id="empty-log"
          class="description"
        >
          Nothing logged yet — your first dive gets a line here.
        </p><ol id="recent-dives" class="result-rows"></ol>
        <p class="micro settings-label">Top divers · All time</p><p
          id="leaderboard-status"
          class="description"
        >
          Loading the field log…
        </p><ol id="leaderboard" class="result-rows"></ol>
        <a class="exit-link micro" href={user ? '/profile' : '/login'}
          >{
            user ? 'Saved scores & achievements ↗' : 'Sign in to save scores ↗'
          }</a
        ><button class="primary-action" data-close>Back to the plate</button>
      </section>
      <section data-panel="commission" class="hidden">
        <div class="sheet-kicker">
          <span class="micro amber">Today's commission</span><button
            class="close-button"
            data-close
            aria-label="Close commission">Close ×</button
          >
        </div>
        <h2 id="commission-title">In the shallows</h2><p
          id="commission-status"
          class="description"
        >
          {
            user
              ? 'Loading today’s commissions…'
              : 'Sign in to track daily commissions and earn XP.'
          }
        </p><div id="commissions"></div>
        {
          !user && (
            <a class="exit-link micro" href="/login">
              Sign in ↗
            </a>
          )
        }<button class="primary-action" data-close>Back to the plate</button>
      </section>
      <AchievementAward /><ChallengeComplete />
    </dialog>
    <template id="commission-template"
      ><article class="commission-card">
        <div class="commission-heading">
          <span data-icon></span><h3 data-name></h3><span
            class="mono amber"
            data-xp></span>
        </div><p class="description" data-description></p><progress
          max="100"
          value="0"
          aria-label="Commission progress"></progress><p
          class="micro"
          data-progress
        >
        </p>
      </article></template
    >
  </Fragment>
</AppLayout>
<script>
  import {
    initBejeweledGame,
    type BejeweledInitResult,
  } from '@/lib/games/bejeweled/init'
  import type {
    BejeweledState,
    BejeweledStats,
  } from '@/lib/games/bejeweled/types'
  import { findLegalSwap } from '@/lib/games/bejeweled/utils'
  import { isEditableTarget } from '@/lib/games/shared/utils'
  import { getUserBestScore } from '@/lib/services/scoreService'
  import { GameID } from '@/lib/games'
  import type { UserChallengeProgress } from '@/lib/challenges'

  const sheet = document.querySelector<HTMLDialogElement>('#field-sheet')!
  const panels = [...sheet.querySelectorAll<HTMLElement>('[data-panel]')]
  const startButton = document.querySelector<HTMLButtonElement>('#start-btn')!
  const pauseButton = document.querySelector<HTMLButtonElement>('#pause-btn')!
  const hintButton = document.querySelector<HTMLButtonElement>('#hint-btn')!
  const signedIn =
    document.querySelector<HTMLElement>('.field-plate')!.dataset.signedIn ===
    'true'
  const setText = (id: string, value: string | number) => {
    document.getElementById(id)!.textContent = String(value)
  }
  let handle: BejeweledInitResult | undefined
  let currentPanel = 'intro'
  let returnPanel = 'intro'
  let resumeAfterSheet = false
  let savedBest: number | null = signedIn ? null : 0
  let visitBest = 0
  let lastResult: { score: number; previousBest: number } | null = null
  let visits = 0
  let visitChain = 0
  let pace: 'swift' | 'measured' = 'swift'
  let glyphs = false
  let sound = true
  let reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
  let audio: AudioContext | undefined
  const controller = new AbortController()
  const { signal } = controller

  const syncBest = () => {
    const best = savedBest === null ? null : Math.max(savedBest, visitBest)
    document.querySelectorAll('[data-best]').forEach(el => {
      el.textContent = best === null ? '—' : best.toLocaleString()
    })
    document
      .getElementById('personal-best')!
      .classList.toggle(
        'hidden',
        savedBest === null ||
          lastResult === null ||
          lastResult.score <= Math.max(savedBest, lastResult.previousBest)
      )
  }
  const showSheet = (panel: string) => {
    currentPanel = panel
    panels.forEach(el =>
      el.classList.toggle('hidden', el.dataset.panel !== panel)
    )
    sheet.dataset.panel = panel
    sheet.setAttribute(
      'aria-labelledby',
      `${panel === 'intro' ? 'intro' : panel}-title`
    )
    if (!sheet.open) {
      sheet.showModal()
    }
    const heading = sheet.querySelector<HTMLElement>(
      `:scope > [data-panel="${panel}"] h2`
    )!
    heading.tabIndex = -1
    heading.focus({ preventScroll: true })
    sheet.scrollTop = 0
  }
  const closeSheet = () => {
    currentPanel = ''
    sheet.close()
    handle?.renderer.getApp()?.canvas.focus()
  }
  const closeInfo = () => {
    if (resumeAfterSheet) {
      resumeAfterSheet = false
      handle?.game.resume()
    } else if (returnPanel) {
      showSheet(returnPanel)
    } else {
      closeSheet()
    }
  }
  const refreshAccount = async () => {
    if (!signedIn) {
      return
    }
    try {
      const response = await fetch('/api/challenges', { signal })
      if (!response.ok) {
        throw new Error('Challenges unavailable')
      }
      const data: {
        challenges: UserChallengeProgress[]
        xp: number
        level: number
        xpProgress: number
        xpToNextLevel: number
        streak: number
      } = await response.json()
      setText('account-label', `LV ${data.level}`)
      setText('xp-label', `Level ${data.level} · ${data.xp} XP`)
      setText('xp-next', `${data.xpToNextLevel} to next level`)
      setText('streak', `${data.streak} days`)
      document.getElementById('xp-panel')!.classList.remove('hidden')
      document.querySelector<HTMLProgressElement>('#xp-fill')!.value =
        data.xpProgress
      const available = data.challenges.filter(
        c => !c.gameId || c.gameId === GameID.BEJEWELED
      )
      setText(
        'commission-status',
        available.length
          ? 'Complete a dive to record your progress.'
          : 'No Bejeweled commissions today. Explore the catalogue for today’s challenges.'
      )
      const container = document.getElementById('commissions')!
      container.replaceChildren()
      available.forEach(challenge => {
        const fragment = document
          .querySelector<HTMLTemplateElement>('#commission-template')!
          .content.cloneNode(true) as DocumentFragment
        fragment.querySelector('[data-icon]')!.textContent = challenge.icon
        fragment.querySelector('[data-name]')!.textContent = challenge.name
        fragment.querySelector('[data-xp]')!.textContent =
          `+${challenge.xpReward} XP`
        fragment.querySelector('[data-description]')!.textContent =
          challenge.description
        fragment.querySelector('progress')!.value = Math.min(
          100,
          (challenge.currentValue / challenge.targetValue) * 100
        )
        fragment.querySelector('[data-progress]')!.textContent =
          challenge.completed
            ? 'Completed'
            : `${challenge.currentValue} / ${challenge.targetValue}`
        container.append(fragment)
      })
    } catch {
      if (!signal.aborted) {
        setText(
          'commission-status',
          'Commissions are unavailable. Open this panel again to retry.'
        )
      }
    }
  }
  const refreshLeaderboard = async () => {
    try {
      const response = await fetch(
        '/api/leaderboard?gameId=bejeweled&limit=5',
        { signal }
      )
      if (!response.ok) {
        throw new Error('Leaderboard unavailable')
      }
      const data: {
        leaderboard: Array<{ rank: number; name: string; score: number }>
      } = await response.json()
      const list = document.getElementById('leaderboard')!
      list.replaceChildren()
      data.leaderboard.forEach(entry => {
        const row = document.createElement('li')
        const name = document.createElement('span')
        name.textContent = `${entry.rank}. ${entry.name}`
        const score = document.createElement('span')
        score.className = 'mono'
        score.textContent = entry.score.toLocaleString()
        row.append(name, score)
        list.append(row)
      })
      setText(
        'leaderboard-status',
        data.leaderboard.length ? '' : 'No recorded dives yet.'
      )
    } catch {
      if (!signal.aborted) {
        setText(
          'leaderboard-status',
          'The leaderboard is unavailable. Open the field log again to retry.'
        )
      }
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-sheet]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        returnPanel = currentPanel
        const state = handle?.game.getState()
        resumeAfterSheet = Boolean(state?.isActive && !state.isPaused)
        if (resumeAfterSheet) {
          handle?.game.pause()
        }
        showSheet(button.dataset.sheet!)
        if (currentPanel === 'log') {
          void refreshLeaderboard()
          void refreshAccount()
        }
        if (currentPanel === 'commission') {
          void refreshAccount()
        }
      },
      { signal }
    )
  )
  sheet
    .querySelectorAll('[data-close]')
    .forEach(button => button.addEventListener('click', closeInfo, { signal }))
  sheet.addEventListener(
    'cancel',
    event => {
      event.preventDefault()
      if (panels.some(panel => panel.inert)) {
        return
      }
      if (['help', 'log', 'commission'].includes(currentPanel)) {
        closeInfo()
      } else if (currentPanel === 'pause') {
        handle?.game.resume()
      }
    },
    { signal }
  )
  // A second Escape makes the browser's close watcher force-close the dialog
  // (non-cancelable), bypassing closeSheet — reopen the panel it stranded.
  sheet.addEventListener(
    'close',
    () => {
      if (currentPanel) {
        showSheet(currentPanel)
      }
    },
    { signal }
  )
  const awards = document.getElementById('achievement-award-overlay')!
  const challenges = document.getElementById('challenge-complete-overlay')!
  const rewardObserver = new MutationObserver(() => {
    const active = !challenges.classList.contains('hidden')
      ? challenges
      : awards.style.display === 'flex'
        ? awards
        : null
    const wasBlocked = panels[0].inert
    if (active && !sheet.open) {
      handle?.game.pause()
    }
    panels.forEach(panel => {
      panel.inert = Boolean(active)
    })
    if (active) {
      active.querySelector<HTMLElement>('[data-card], button')?.focus()
    } else if (wasBlocked && sheet.open) {
      showSheet(currentPanel)
    }
  })
  rewardObserver.observe(awards, {
    attributes: true,
    attributeFilter: ['style'],
  })
  rewardObserver.observe(challenges, {
    attributes: true,
    attributeFilter: ['class'],
  })

  const preferences = () => {
    handle?.renderer.setPreferences(pace, glyphs, reducedMotion)
    document
      .querySelectorAll<HTMLButtonElement>('[data-pace]')
      .forEach(button =>
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.pace === pace)
        )
      )
    for (const [id, value] of [
      ['glyphs-btn', glyphs],
      ['sound-btn', sound],
      ['motion-btn', reducedMotion],
    ] as const) {
      const button = document.getElementById(id)!
      button.setAttribute('aria-pressed', String(value))
      button.querySelector('[data-state]')!.textContent = value ? 'On' : 'Off'
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-pace]').forEach(button =>
    button.addEventListener(
      'click',
      () => {
        pace = button.dataset.pace as typeof pace
        preferences()
      },
      { signal }
    )
  )
  document.getElementById('glyphs-btn')!.addEventListener(
    'click',
    () => {
      glyphs = !glyphs
      preferences()
    },
    { signal }
  )
  document.getElementById('sound-btn')!.addEventListener(
    'click',
    () => {
      sound = !sound
      preferences()
    },
    { signal }
  )
  document.getElementById('motion-btn')!.addEventListener(
    'click',
    () => {
      reducedMotion = !reducedMotion
      preferences()
    },
    { signal }
  )
  pauseButton.addEventListener('click', () => handle?.game.pause(), { signal })
  document
    .getElementById('resume-btn')!
    .addEventListener('click', () => handle?.game.resume(), { signal })
  document.getElementById('reset-btn')!.addEventListener(
    'click',
    () => {
      handle?.renderer.cancelAnimations()
      handle?.game.reset()
      handle?.game.start()
    },
    { signal }
  )
  const hint = () => {
    const state = handle?.game.getState()
    if (!state?.isActive || state.isPaused || state.isAnimating) {
      return
    }
    if (state.selected) {
      handle!.game.clickCell(state.selected.row, state.selected.col)
    }
    const move = findLegalSwap(state.grid)
    handle!.renderer.showHint(move ?? [])
    setText(
      'board-notice',
      move
        ? `Swap row ${move[0].row + 1}, column ${move[0].col + 1} with row ${move[1].row + 1}, column ${move[1].col + 1}`
        : 'No legal swaps — pause to start a fresh dive'
    )
  }
  hintButton.addEventListener('click', hint, { signal })
  document.addEventListener(
    'keydown',
    event => {
      if (
        isEditableTarget(event.target) ||
        event.target instanceof HTMLButtonElement ||
        event.target instanceof HTMLAnchorElement
      ) {
        return
      }
      if (panels.some(panel => panel.inert)) {
        return
      }
      if (event.key.toLowerCase() === 'p') {
        if (currentPanel === 'pause') {
          event.preventDefault()
          handle?.game.resume()
        } else if (!sheet.open) {
          event.preventDefault()
          handle?.game.pause()
        }
        return
      }
      if (sheet.open) {
        return
      }
      if (event.key.toLowerCase() === 'h') {
        event.preventDefault()
        hint()
        return
      }
      const delta = {
        ArrowUp: [-1, 0],
        ArrowDown: [1, 0],
        ArrowLeft: [0, -1],
        ArrowRight: [0, 1],
      }[event.key]
      if (delta) {
        event.preventDefault()
        handle?.renderer.moveCursor(delta[0], delta[1])
      } else if (event.key === 'Enter' || event.code === 'Space') {
        event.preventDefault()
        handle?.renderer.selectCursor()
      }
    },
    { signal }
  )
  const blip = () => {
    if (!sound) {
      return
    }
    try {
      audio ??= new AudioContext()
      void audio.resume().catch(() => {})
      const oscillator = audio.createOscillator(),
        gain = audio.createGain()
      oscillator.type = 'triangle'
      oscillator.frequency.value = 540
      gain.gain.setValueAtTime(0.035, audio.currentTime)
      gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.14)
      oscillator.connect(gain)
      gain.connect(audio.destination)
      oscillator.start()
      oscillator.stop(audio.currentTime + 0.14)
    } catch {
      /* Audio may be unavailable in the browser. */
    }
  }
  const setTime = (time: number) => {
    const bar = document.querySelector<HTMLProgressElement>('#time-fill')!
    bar.value = time
    for (const el of [bar, document.getElementById('time-remaining')!]) {
      el.classList.toggle('amber', time <= 20 && time > 10)
      el.classList.toggle('urgent', time <= 10)
    }
  }
  showSheet('intro')
  const initialize = async () => {
    try {
      handle = await initBejeweledGame(
        {},
        {
          onStart: () => {
            closeSheet()
            pauseButton.disabled = false
            hintButton.disabled = false
            setText('score', 0)
            setText('time-remaining', 60)
            setTime(60)
            setText('board-notice', 'Drag a gem onto its neighbour')
          },
          onPause: () => showSheet('pause'),
          onResume: closeSheet,
          onTimeUpdate: setTime,
          onScoreUpdate: score => {
            if (score > 0) {
              blip()
            }
          },
          onStateChange: state => {
            const s = state as BejeweledState
            setText(
              'board-notice',
              s.isAnimating
                ? 'Chain in motion'
                : 'Drag a gem onto its neighbour'
            )
            setText('moves', s.movesMade)
            setText(
              'cascade-label',
              s.combo > 0
                ? `×${s.combo} chain`
                : s.isAnimating
                  ? 'Swapping'
                  : 'Idle'
            )
            setText(
              'max-combo',
              `×${handle?.game.getGameStats().maxCombo ?? 0}`
            )
            const cascadeLabel = document.getElementById('cascade-label')!
            cascadeLabel.classList.toggle('accent', s.combo > 0 && s.combo < 3)
            cascadeLabel.classList.toggle('amber', s.combo >= 3)
            document
              .querySelectorAll('#cascade-pips span')
              .forEach((pip, i) => pip.classList.toggle('active', i < s.combo))
            hintButton.disabled = !s.isActive || s.isAnimating
          },
          onEnd: (score, stats) => {
            const s = stats as BejeweledStats
            pauseButton.disabled = true
            hintButton.disabled = true
            lastResult = { score, previousBest: visitBest }
            visitBest = Math.max(visitBest, score)
            syncBest()
            setText('final-moves', s.movesMade)
            setText('final-combo', `×${s.maxCombo}`)
            setText('final-largest', s.largestMatch)
            setText('final-matches', s.totalMatches)
            setText(
              'per-move',
              s.movesMade ? Math.round(score / s.movesMade) : '—'
            )
            setText(
              'results-title',
              s.maxCombo >= 3 ? 'A chain reaction' : 'The tide turns'
            )
            visits++
            visitChain = Math.max(visitChain, s.maxCombo)
            setText('visit-count', visits)
            setText('visit-chain', `×${visitChain}`)
            document.getElementById('empty-log')!.classList.add('hidden')
            const row = document.createElement('li'),
              label = document.createElement('span'),
              value = document.createElement('span')
            label.textContent = `Dive ${visits} · ${s.movesMade} moves · ×${s.maxCombo}`
            value.className = 'mono'
            value.textContent = score.toLocaleString()
            row.append(label, value)
            document.getElementById('recent-dives')!.prepend(row)
            showSheet('results')
          },
        },
        {
          width: 640,
          height: 640,
          responsive: false,
          gridPadding: 0,
          cellPadding: 12.8,
          backgroundColor: 0x070b16,
        }
      )
      // onEnd fires before the score save resolves, so account state (XP,
      // challenge labels) refreshes off the post-save structured end event.
      // The event.data guard skips bare end events forwarded from the timer.
      handle.game.on('end', event => {
        if (event.data) {
          void refreshAccount()
        }
      })
      preferences()
      startButton.disabled = false
      startButton.textContent = 'Begin the dive'
      if (signedIn) {
        savedBest = await getUserBestScore(GameID.BEJEWELED)
      }
      syncBest()
      void refreshAccount()
    } catch (error) {
      console.error('Failed to initialize Bejeweled:', error)
      document.getElementById('game-error')!.classList.remove('hidden')
      startButton.textContent = 'Plate unavailable'
    }
  }
  void initialize()
  document.addEventListener(
    'visibilitychange',
    () => {
      if (document.hidden) {
        handle?.game.pause()
      }
    },
    { signal }
  )
  window.addEventListener(
    'pagehide',
    event => {
      if (event.persisted) {
        handle?.game.pause()
        return
      }
      controller.abort()
      rewardObserver.disconnect()
      handle?.cleanup()
      void audio?.close()
    },
    { signal }
  )
</script>
