---
import AppLayout from '@/layouts/AppLayout.astro'
import GravityFlipScreen from '@/components/islands/games/GravityFlipScreen'
---

<AppLayout
  title="Gravity Flip - Cetus Minigames"
  description="Flip gravity to dodge hazards and collect stars for 60 seconds."
  navigation={[
    { href: '/', label: 'Home' },
    { href: '#', label: 'Gravity Flip' },
  ]}
  includeFooter={false}
>
  <GravityFlipScreen client:load />
</AppLayout>

<style is:global>
  /* Static canvas markup lives in the GravityFlipScreen island (HPA-393),
     so these selectors must be global — Astro-scoped styles would never
     match island-rendered elements. */
  #gravity-flip-canvas canvas {
    display: block;
    max-width: 100%;
    height: auto;
    touch-action: manipulation;
  }
</style>
