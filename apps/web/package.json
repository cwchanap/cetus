{
  "name": "@cetus/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4325",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:dev": "mkdir -p ./db && touch ./db/db.sqlite && turso dev --db-file ./db/db.sqlite",
    "web:dev": "astro dev --port 4325",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "validate:ice-slide-expedition": "bun scripts/validate-ice-slide-expedition.ts",
    "test:e2e": "playwright test",
    "e2e:db:init": "bun run scripts/init-e2e-db.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/vercel": "^8.2.0",
    "@cetus/api-client": "workspace:*",
    "@cetus/games": "workspace:*",
    "@cetus/shared": "workspace:*",
    "@cetus/tokens": "workspace:*",
    "@cetus/ui": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "astro": "^5.10.1",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "cropperjs": "^1.6.2",
    "kysely": "^0.29.6",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cetus/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "astro-eslint-parser": "^1.2.2",
    "eslint-plugin-astro": "^1.3.1",
    "jsdom": "^30.1.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
